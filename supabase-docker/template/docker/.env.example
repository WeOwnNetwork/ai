# {{ project_name }} - Environment Variables Example
# ⚠️ DEPRECATED for app secrets: this project uses Infisical runtime injection.
# Do NOT create .env files with real DB passwords, JWT secrets, or API keys.
#
# Secrets are fetched from Infisical at container startup:
#   infisical run --env=prod -- docker compose up -d
#
# Required Infisical secrets (add these in your Infisical project):
#   POSTGRES_DB                 — Postgres database name (default: postgres)
#   POSTGRES_USER               — Postgres superuser (default: postgres)
#   POSTGRES_PASSWORD           — Postgres superuser password
#   JWT_SECRET                  — 32+ char HS256 secret used by GoTrue + PostgREST
#   ANON_KEY                    — JWT signed with JWT_SECRET, role=anon
#   SERVICE_ROLE_KEY            — JWT signed with JWT_SECRET, role=service_role
#   GOTRUE_JWT_SECRET           — usually same value as JWT_SECRET
#   PGRST_JWT_SECRET            — usually same value as JWT_SECRET
#   REALTIME_SECRET_KEY_BASE    — 64-char Realtime cookie/session signing key
#   REALTIME_DB_ENC_KEY         — 16-char Realtime column encryption key
#   DASHBOARD_USERNAME          — Studio basic-auth username
#   DASHBOARD_PASSWORD + DASHBOARD_PASSWORD_BCRYPT          — Studio basic-auth password
#   MINIMUS_TOKEN               — (optional) for reg.mini.dev image pulls
#   SPACES_ACCESS_KEY           — (optional) DO Spaces key for remote backups
#   SPACES_SECRET_KEY           — (optional) DO Spaces secret for remote backups
#
# Only the Infisical Machine Identity (Client ID + Client Secret) should
# exist on the host — everything else comes from Infisical.

# Domain (non-sensitive — can stay here or move to Infisical)
DOMAIN={{ domain }}

# Container Images (non-sensitive)
POSTGRES_IMAGE={{ postgres_image }}
POSTGREST_IMAGE={{ postgrest_image }}
GOTRUE_IMAGE={{ gotrue_image }}
REALTIME_IMAGE={{ realtime_image }}
STUDIO_IMAGE={{ studio_image }}
CADDY_IMAGE={{ caddy_image }}
POSTGRES_VERSION={{ postgres_version }}

# Infisical Configuration (Machine Identity only)
INFISICAL_CLIENT_ID=your-client-id
INFISICAL_CLIENT_SECRET=your-client-secret
INFISICAL_PROJECT_ID={{ infisical_project_id | default('') }}
INFISICAL_ENVIRONMENT={{ infisical_environment | default('prod') }}
