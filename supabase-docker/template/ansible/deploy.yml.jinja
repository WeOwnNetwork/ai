---
# {{ project_name }} — Idempotent deployment playbook (Path C app layer)
#
# This playbook owns ALL post-bootstrap state on the droplet. Cloud-init only
# handles first-boot bootstrap (Docker, Infisical CLI, .infisical-auth.env,
# bootstrap-secret rotation). Everything else lives here so ongoing changes
# don't require `tofu taint` (which would destroy + recreate the droplet).
#
# What this playbook manages:
#   - compose.yaml (uploaded from docker/compose.prod.yaml)
#   - Caddyfile    (uploaded from docker/Caddyfile)
#   - backup.sh    (uploaded from scripts/backup.sh)
#   - daily backup cron + logrotate
#   - docker compose up (reconciled — bounced if any uploaded file changed)
#   - Pop schema seeding (idempotent — runs only if `pop` schema missing)
#   - DO droplet tagging: feature tags (skinny-backup) + commit tag (commit-<sha>)
#
# Pre-conditions enforced:
#   - The droplet must have completed cloud-init (.bootstrap-complete exists)
#   - INFISICAL_PROJECT_ID must be set in the environment
#   - doctl must be authenticated locally (for tag updates)
#
# Usage:
#   INFISICAL_PROJECT_ID=<id> ansible-playbook -i 'root@<droplet-ip>,' \
#     {{ project_name }}/ansible/deploy.yml
#
#   Or use the wrapper: scripts/deploy.sh root@<droplet-ip>

- name: Deploy {{ project_name }} app layer
  hosts: all
  gather_facts: false
  become: true
  vars:
    app_dir: /opt/{{ project_name | replace('-', '_') }}
    infisical_project_id: "{{ '{{' }} lookup('env', 'INFISICAL_PROJECT_ID') {{ '}}' }}"
    infisical_env: "{{ '{{' }} lookup('env', 'INFISICAL_ENV') | default('prod', True) {{ '}}' }}"
    droplet_name: "{{ project_name }}"
    git_commit_short: "{{ '{{' }} lookup('pipe', 'git rev-parse --short HEAD 2>/dev/null || echo unknown') {{ '}}' }}"
    postgres_image: {{ postgres_image }}
    postgrest_image: {{ postgrest_image }}
    gotrue_image: {{ gotrue_image }}
    realtime_image: {{ realtime_image }}
    studio_image: {{ studio_image }}
    caddy_image: {{ caddy_image }}
    enable_studio: {{ enable_studio | lower }}
    enable_realtime: {{ enable_realtime | lower }}

  pre_tasks:
    - name: Require INFISICAL_PROJECT_ID env var
      ansible.builtin.assert:
        that:
          - infisical_project_id | length > 0
        fail_msg: >-
          INFISICAL_PROJECT_ID env var is required. This is the same value
          as terraform.tfvars infisical_project_id. Run:
          INFISICAL_PROJECT_ID=<id> ansible-playbook ...

    - name: Verify droplet has completed cloud-init bootstrap
      ansible.builtin.stat:
        path: "{{ '{{' }} app_dir {{ '}}' }}/.bootstrap-complete"
      register: bootstrap_marker

    - name: Fail clearly if bootstrap is not complete
      ansible.builtin.fail:
        msg: >-
          {{ '{{' }} app_dir {{ '}}' }}/.bootstrap-complete is missing — droplet
          has not finished cloud-init. Wait a few minutes after `tofu apply`
          and retry. Check /var/log/cloud-init-output.log on the droplet for
          errors.
      when: not bootstrap_marker.stat.exists

    - name: Verify Infisical auth file exists (created by cloud-init)
      ansible.builtin.stat:
        path: "{{ '{{' }} app_dir {{ '}}' }}/.infisical-auth.env"
      register: auth_file

    - name: Fail clearly if auth file is missing
      ansible.builtin.fail:
        msg: >-
          {{ '{{' }} app_dir {{ '}}' }}/.infisical-auth.env is missing —
          Infisical Machine Identity bootstrap failed. Check
          /var/log/cloud-init-output.log and
          /var/log/{{ project_name | replace('-', '_') }}-rotation.log.
      when: not auth_file.stat.exists

  tasks:
    - name: Upload compose.yaml
      ansible.builtin.copy:
        src: ../docker/compose.prod.yaml
        dest: "{{ '{{' }} app_dir {{ '}}' }}/compose.yaml"
        owner: root
        group: root
        mode: "0644"
      notify: Reconcile docker compose stack

    - name: Upload Caddyfile
      ansible.builtin.copy:
        src: ../docker/Caddyfile
        dest: "{{ '{{' }} app_dir {{ '}}' }}/Caddyfile"
        owner: root
        group: root
        mode: "0644"
      notify: Reconcile docker compose stack

    - name: Upload shared shell lib (sourced by backup.sh + restore.sh)
      # backup.sh line 30 and restore.sh line 27 both `source $SCRIPT_DIR/lib.sh`.
      # Without this task the daily cron fails at boot with "No such file or
      # directory" the first time backup.sh runs - and cron eats stdout, so
      # the failure only surfaces as missing files in the DO Spaces bucket.
      ansible.builtin.copy:
        src: ../scripts/lib.sh
        dest: "{{ '{{' }} app_dir {{ '}}' }}/lib.sh"
        owner: root
        group: root
        mode: "0644"

    - name: Upload backup script
      ansible.builtin.copy:
        src: ../scripts/backup.sh
        dest: "{{ '{{' }} app_dir {{ '}}' }}/backup.sh"
        owner: root
        group: root
        mode: "0750"

    - name: Upload restore script
      ansible.builtin.copy:
        src: ../scripts/restore.sh
        dest: "{{ '{{' }} app_dir {{ '}}' }}/restore.sh"
        owner: root
        group: root
        mode: "0750"

    - name: Ensure Pop schema migrations directory exists on host
      ansible.builtin.file:
        path: "{{ '{{' }} app_dir {{ '}}' }}/migrations"
        state: directory
        owner: root
        group: root
        mode: "0755"

    - name: Upload Pop schema migrations (idempotent — applied below only if pop schema absent)
      ansible.builtin.copy:
        src: ../docker/migrations/
        dest: "{{ '{{' }} app_dir {{ '}}' }}/migrations/"
        owner: root
        group: root
        mode: "0644"
      register: migrations_upload
      failed_when: false  # migrations/ may be empty on a fresh clone

    - name: Install daily backup cron (wraps backup.sh with Infisical injection)
      ansible.builtin.copy:
        content: |
          #!/bin/bash
          # Daily backup with Infisical runtime secret injection. Managed by
          # {{ project_name }}/ansible/deploy.yml — edit there, not here.
          #
          # Uses the same timeout + --plain + INFISICAL_TOKEN export pattern
          # as the deploy playbook tasks: raw `infisical login --silent`
          # hangs indefinitely if the CLI hits its interactive-prompt code
          # path (cached-cred parse failure), and cron would eat stdout so
          # the wedge is silent - you'd only notice via missing backups.
          set -euo pipefail
          # shellcheck disable=SC1091
          source {{ '{{' }} app_dir {{ '}}' }}/.infisical-auth.env
          INFISICAL_TOKEN=$(timeout 30 infisical login --method=universal-auth \
            --client-id="$INFISICAL_CLIENT_ID" \
            --client-secret="$INFISICAL_CLIENT_SECRET" \
            --plain --silent)
          [ -n "$INFISICAL_TOKEN" ] || { echo "$(date -Iseconds) infisical login timed out" >&2; exit 1; }
          export INFISICAL_TOKEN
          timeout 3600 infisical run \
            --projectId={{ '{{' }} infisical_project_id {{ '}}' }} \
            --env={{ '{{' }} infisical_env {{ '}}' }} \
            -- {{ '{{' }} app_dir {{ '}}' }}/backup.sh \
            >> /var/log/{{ project_name | replace('-', '_') }}-backup.log 2>&1
        dest: /etc/cron.daily/{{ project_name | replace('-', '_') }}-backup
        owner: root
        group: root
        mode: "0750"

    - name: Ensure logrotate config for backup log
      ansible.builtin.copy:
        content: |
          # Managed by {{ project_name }}/ansible/deploy.yml — do not edit on host.
          /var/log/{{ project_name | replace('-', '_') }}-backup.log {
            weekly
            rotate 12
            compress
            missingok
            notifempty
            create 0640 root root
          }
        dest: /etc/logrotate.d/{{ project_name | replace('-', '_') }}-backup
        owner: root
        group: root
        mode: "0644"

    - name: Optional docker login for private registry (reg.mini.dev)
      # Guarded by `use_minimus_registry` (default false) because the
      # Infisical CLI's internal login hangs indefinitely with --silent when
      # the secret doesn't exist, so we skip the whole block unless the
      # operator explicitly opts in. If you DO pull from reg.mini.dev, set
      # `use_minimus_registry: true` in your inventory OR pass
      # `--extra-vars use_minimus_registry=true` and ensure MINIMUS_TOKEN is
      # in your Infisical app project.
      when: use_minimus_registry | default(false) | bool
      no_log: true  # MINIMUS_TOKEN is a secret — prevent exposure in Ansible logs
      ansible.builtin.shell: |
        set -euo pipefail
        source {{ '{{' }} app_dir {{ '}}' }}/.infisical-auth.env
        INFISICAL_TOKEN=$(timeout 30 infisical login --method=universal-auth \
          --client-id="$INFISICAL_CLIENT_ID" \
          --client-secret="$INFISICAL_CLIENT_SECRET" \
          --plain --silent)
        [ -n "$INFISICAL_TOKEN" ] || { echo "login timeout"; exit 1; }
        export INFISICAL_TOKEN
        MINIMUS_TOKEN=$(timeout 30 infisical secrets get MINIMUS_TOKEN \
          --projectId={{ '{{' }} infisical_project_id {{ '}}' }} \
          --env={{ '{{' }} infisical_env {{ '}}' }} \
          --plain 2>/dev/null || echo "")
        if [[ -n "$MINIMUS_TOKEN" ]]; then
          echo "$MINIMUS_TOKEN" | docker login reg.mini.dev --username token --password-stdin
          echo "Logged in to reg.mini.dev"
        else
          echo "MINIMUS_TOKEN not set, skipping private registry login"
        fi
      args:
        executable: /bin/bash
      register: docker_login
      changed_when: "'Logged in' in docker_login.stdout"
      failed_when: false

    - name: Pull container images
      community.docker.docker_image_pull:
        name: "{{ '{{' }} item {{ '}}' }}"
      loop:
        - "{{ '{{' }} postgres_image {{ '}}' }}"
        - "{{ '{{' }} postgrest_image {{ '}}' }}"
        - "{{ '{{' }} gotrue_image {{ '}}' }}"
        - "{{ '{{' }} caddy_image {{ '}}' }}"
      register: image_pull
      retries: 3
      delay: 5
      until: image_pull is succeeded

    - name: Pull realtime image (conditional)
      community.docker.docker_image_pull:
        name: "{{ '{{' }} realtime_image {{ '}}' }}"
      when: enable_realtime | bool
      register: realtime_image_pull
      retries: 3
      delay: 5
      until: realtime_image_pull is succeeded

    - name: Pull studio image (conditional)
      community.docker.docker_image_pull:
        name: "{{ '{{' }} studio_image {{ '}}' }}"
      when: enable_studio | bool
      register: studio_image_pull
      retries: 3
      delay: 5
      until: studio_image_pull is succeeded

    - name: Start compose stack (idempotent — `up -d` is a no-op if nothing changed)
      # `docker compose up -d` with `infisical run` wrapper so each service's
      # environment-variable references (${POSTGRES_PASSWORD} etc.) resolve
      # from Infisical at process startup. Bounce a service to refresh secrets.
      #
      # NOTE: `infisical login --silent` hangs indefinitely if the CLI's
      # interactive prompt is triggered (e.g. cached-cred parse failure).
      # We use `--plain` to capture the token to a variable, `timeout 30`
      # to bail early, and export INFISICAL_TOKEN so subsequent `infisical
      # run` calls skip the login step entirely.
      ansible.builtin.shell: |
        set -euo pipefail
        source {{ '{{' }} app_dir {{ '}}' }}/.infisical-auth.env
        INFISICAL_TOKEN=$(timeout 30 infisical login --method=universal-auth \
          --client-id="$INFISICAL_CLIENT_ID" \
          --client-secret="$INFISICAL_CLIENT_SECRET" \
          --plain --silent)
        [ -n "$INFISICAL_TOKEN" ] || { echo "infisical login timed out"; exit 1; }
        export INFISICAL_TOKEN
        cd {{ '{{' }} app_dir {{ '}}' }}
        timeout 300 infisical run \
          --projectId={{ '{{' }} infisical_project_id {{ '}}' }} \
          --env={{ '{{' }} infisical_env {{ '}}' }} \
          -- docker compose up -d --remove-orphans
      args:
        executable: /bin/bash
      register: compose_up
      changed_when: "'Started' in compose_up.stderr or 'Created' in compose_up.stderr or 'Recreated' in compose_up.stderr"

    - name: Wait for Postgres to accept connections
      ansible.builtin.shell: |
        set -euo pipefail
        cd {{ '{{' }} app_dir {{ '}}' }}
        docker compose exec -T db pg_isready -U postgres
      args:
        executable: /bin/bash
      register: pg_ready
      retries: 30
      delay: 5
      until: pg_ready.rc == 0
      changed_when: false

    - name: Check whether Pop schema is already seeded
      # Fast-path skip: if schema `pop` exists, we assume migrations are done.
      # The migration file is fully idempotent per its own header (IF NOT
      # EXISTS + duplicate_object guards throughout), so a false negative
      # here just triggers a safe re-apply - never data loss.
      #
      # Deliberately NO `bash -c` wrap and NO `-e PGPASSWORD=` flag: psql
      # inside the container connects via the local UNIX socket with peer
      # auth (postgres OS user -> postgres DB role), which needs no password
      # AND avoids the shell-quote-hell that a bash-c-wrapped SQL with
      # embedded single quotes creates. `< /dev/null` closes stdin so
      # `docker compose exec -T` can't SIGSTOP on a TTY-read race with
      # ansible's non-interactive SSH session.
      ansible.builtin.shell: |
        set -euo pipefail
        source {{ '{{' }} app_dir {{ '}}' }}/.infisical-auth.env
        INFISICAL_TOKEN=$(timeout 30 infisical login --method=universal-auth \
          --client-id="$INFISICAL_CLIENT_ID" \
          --client-secret="$INFISICAL_CLIENT_SECRET" \
          --plain --silent)
        [ -n "$INFISICAL_TOKEN" ] || { echo "infisical login timed out"; exit 1; }
        export INFISICAL_TOKEN
        cd {{ '{{' }} app_dir {{ '}}' }}
        timeout 60 infisical run \
          --projectId={{ '{{' }} infisical_project_id {{ '}}' }} \
          --env={{ '{{' }} infisical_env {{ '}}' }} \
          -- docker compose exec -T db \
             psql -U postgres -d "${POSTGRES_DB:-postgres}" -tAc \
             "SELECT 1 FROM information_schema.schemata WHERE schema_name = 'pop'" \
             </dev/null
      args:
        executable: /bin/bash
      register: pop_schema_check
      changed_when: false
      failed_when: false
      no_log: true  # response includes the DB session — avoid logging connection strings

    - name: Apply Pop schema migrations (only if pop schema missing AND migrations present)
      # Wrap docker exec in `bash -c '...'` inside `infisical run` so
      # $POSTGRES_PASSWORD resolves in the injected child env, not the
      # outer `set -u` shell (which would fail unbound-variable).
      ansible.builtin.shell: |
        set -euo pipefail
        source {{ '{{' }} app_dir {{ '}}' }}/.infisical-auth.env
        INFISICAL_TOKEN=$(timeout 30 infisical login --method=universal-auth \
          --client-id="$INFISICAL_CLIENT_ID" \
          --client-secret="$INFISICAL_CLIENT_SECRET" \
          --plain --silent)
        [ -n "$INFISICAL_TOKEN" ] || { echo "infisical login timed out"; exit 1; }
        export INFISICAL_TOKEN
        cd {{ '{{' }} app_dir {{ '}}' }}
        for f in migrations/*.sql; do
          [ -f "$f" ] || continue
          echo "==> Applying $f"
          timeout 120 infisical run \
            --projectId={{ '{{' }} infisical_project_id {{ '}}' }} \
            --env={{ '{{' }} infisical_env {{ '}}' }} \
            -- bash -c 'docker compose exec -T -e PGPASSWORD="$POSTGRES_PASSWORD" db \
               psql -U postgres -d "${POSTGRES_DB:-postgres}" -v ON_ERROR_STOP=1' \
            < "$f"
        done
      args:
        executable: /bin/bash
      when: pop_schema_check.stdout | trim != '1'
      register: pop_schema_apply
      changed_when: pop_schema_apply.rc == 0

    - name: Wait for PostgREST health
      ansible.builtin.uri:
        url: http://127.0.0.1/rest/v1/
        status_code: [200, 401]   # PostgREST 401 (no JWT) is a healthy response
      register: postgrest_health
      retries: 20
      delay: 5
      until: postgrest_health.status in [200, 401]
      failed_when: false

    - name: Wait for GoTrue health
      ansible.builtin.uri:
        url: http://127.0.0.1/auth/v1/health
        status_code: 200
      register: gotrue_health
      retries: 20
      delay: 5
      until: gotrue_health.status == 200
      # Fail the deploy when auth never comes healthy — a green play over a
      # dead stack is the silent-failure class this repo keeps paying for.
      failed_when: gotrue_health.status != 200

    # ─── DO droplet tagging ──────────────────────────────────────────────
    # After a successful deploy, update droplet tags to reflect actual state:
    # - skinny-backup tag (we just configured the cron)
    # - commit-<sha> tag (which git commit produced this deployment)
    # See docs/INFRA_BOOTSTRAP_PATTERN.md "DO tag taxonomy" for the full scheme.
    # Tags are mutated via the shared scripts/tag-droplet.sh helper; ansible
    # runs it locally via delegate_to.

    # Resolve the WeOwn repo root so `scripts/tag-droplet.sh` is reachable even
    # when this play was rendered OUTSIDE the repo. `weown-fleet render-deploy`
    # renders to an ephemeral temp dir, so the old `chdir: playbook_dir |
    # dirname x4` never resolved and `failed_when: false` swallowed it —
    # droplet tagging has therefore NEVER run (0 of 53 droplets carried a
    # commit- tag on 2026-08-22, and #143's blast radius had to be
    # reconstructed by hand). Resolution order: -e weown_repo_root  ->
    # $WEOWN_REPO_ROOT -> git toplevel from playbook_dir.
    - name: Update DO droplet tags (skinny-backup + commit-<sha>)
      ansible.builtin.shell: |
        set -euo pipefail
        ROOT="{{ '{{' }} weown_repo_root | default('', true) {{ '}}' }}"
        [[ -n "$ROOT" ]] || ROOT="${WEOWN_REPO_ROOT:-}"
        [[ -n "$ROOT" ]] || ROOT="$(cd '{{ '{{' }} playbook_dir {{ '}}' }}' && git rev-parse --show-toplevel 2>/dev/null || true)"
        HELPER="$ROOT/scripts/tag-droplet.sh"
        if [[ -z "$ROOT" || ! -x "$HELPER" ]]; then
          echo "TAGGING-SKIPPED: tag-droplet.sh not found (looked under '${ROOT:-<unresolved>}')."
          echo "TAGGING-SKIPPED: this droplet keeps whatever commit- tag it already had."
          echo "TAGGING-SKIPPED: re-run with -e weown_repo_root=/path/to/WeOwnNetwork/ai to fix."
          exit 7
        fi
        "$HELPER" "{{ '{{' }} droplet_name {{ '}}' }}" \
          replace-prefix commit- "commit-{{ '{{' }} git_commit_short {{ '}}' }}" \
          add skinny-backup
      args:
        executable: /bin/bash
      register: _tag_result
      delegate_to: localhost
      become: false
      changed_when: false
      # Tagging is a side-effect: its failure must not red an otherwise good
      # deploy. But it must never be SILENT again — the next task surfaces it.
      failed_when: false

    - name: Surface the droplet-tagging outcome (never silent)
      ansible.builtin.debug:
        msg: "{{ '{{' }} (_tag_result.stdout_lines | default([])) + (_tag_result.stderr_lines | default([])) {{ '}}' }}"
      when: _tag_result.rc | default(0) != 0

    - name: Report success
      ansible.builtin.debug:
        msg: >-
          {{ project_name }} app layer deployed (commit
          {{ '{{' }} git_commit_short {{ '}}' }}).
          Studio:  https://{{ domain }}/
          REST:    https://{{ domain }}/rest/v1
          Auth:    https://{{ domain }}/auth/v1

  handlers:
    - name: Reconcile docker compose stack
      # Force-recreate ensures containers pick up changes to the compose file
      # or any uploaded config. Still wrapped in `infisical run` so env-var
      # references in compose resolve.
      ansible.builtin.shell: |
        set -euo pipefail
        source {{ '{{' }} app_dir {{ '}}' }}/.infisical-auth.env
        INFISICAL_TOKEN=$(timeout 30 infisical login --method=universal-auth \
          --client-id="$INFISICAL_CLIENT_ID" \
          --client-secret="$INFISICAL_CLIENT_SECRET" \
          --plain --silent)
        [ -n "$INFISICAL_TOKEN" ] || { echo "infisical login timed out"; exit 1; }
        export INFISICAL_TOKEN
        cd {{ '{{' }} app_dir {{ '}}' }}
        timeout 300 infisical run \
          --projectId={{ '{{' }} infisical_project_id {{ '}}' }} \
          --env={{ '{{' }} infisical_env {{ '}}' }} \
          -- docker compose up -d --force-recreate --remove-orphans
      args:
        executable: /bin/bash
      changed_when: false
