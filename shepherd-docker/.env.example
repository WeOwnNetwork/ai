# Shepherd POC (PRJ-435) — placeholders only. Copy to .env on the host.
# No API keys: MOCK_PROVIDER=true uses the deterministic/offline lane.

SHEPHERD_DOMAIN=shepherd.weown.tools
SHEPHERD_PORT=8080
MOCK_PROVIDER=true
LOG_LEVEL=debug

# Pinned Caddy tag (compose fail-loud if unset on the host copy).
CADDY_IMAGE=caddy:2.10.2-alpine
