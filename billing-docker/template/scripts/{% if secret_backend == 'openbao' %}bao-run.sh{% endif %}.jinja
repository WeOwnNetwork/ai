#!/bin/sh
# bao-run.sh — {{ project_name }}: run a command ON THE HOST with this site's
# backup secrets read from OpenBao (secret_backend=openbao; weown-fleet#166).
#
#   /opt/{{ project_name | replace('-', '_') }}/bao-run.sh /opt/{{ project_name | replace('-', '_') }}/backup.sh
#
# The host-side counterpart of `infisical run` for backup.sh, restore.sh and the
# daily backup cron. It reuses entrypoint-bao.sh, the wrapper the containers
# use (same AppRole, same KV path), pointed at the host copies of the CA and
# the secret-id that ansible/deploy.yml places. Only the keys the backup and
# restore paths read are loaded; a missing key refuses the run, so a backup
# never runs half-configured.
set -eu
APP_DIR="/opt/{{ project_name | replace('-', '_') }}"
[ $# -gt 0 ] || { echo "usage: bao-run.sh CMD [ARGS...]" >&2; exit 2; }

# One login attempt and no cooldown: a cron or an operator run must not sleep
# for minutes on a refused login, and each failed attempt counts toward the
# role's lockout, which db and web share.
exec env \
  BAO_CACERT="$APP_DIR/.bao-ca.crt" \
  BAO_SECRET_ID_FILE="$APP_DIR/.bao-secret-id" \
  BAO_LOGIN_ATTEMPTS=1 \
  BAO_LOGIN_COOLDOWN=0 \
  "$APP_DIR/entrypoint-bao.sh" \
  --keys "POSTGRES_USER POSTGRES_DB POSTGRES_PASSWORD{% if backup_remote_storage == 'do-spaces' %} SPACES_ACCESS_KEY SPACES_SECRET_KEY{% endif %}" \
  -- "$@"
