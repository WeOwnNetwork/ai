#!/bin/sh
# entrypoint-bao.sh — {{ project_name }}: OpenBao AppRole container entrypoint
# (secret_backend=openbao; weown-fleet#166). Logs in with the instance AppRole,
# reads this site's KV document, exports the values, revokes its token and execs
# the image's real entrypoint. Values move process to process: never printed,
# never on argv, never in `docker inspect`.
#
# Two modes, because the images differ:
#   --keys "A B C" -- CMD...   one `bao kv get -field=K` per listed key. For images
#                              with no node, python or jq (postgres:16). No eval.
#   --document -- CMD...       every key in the document, via python3 (the web
#                              image is Python). Same name checks as AnythingLLM's
#                              node version, plus PYTHON* on the denylist.
#
# POSIX sh, not bash: it must run in Debian (postgres) and slim Python images.
# The secret-id is unwrapped ON THE HOST by ansible/deploy.yml (a container-side
# unwrap deadlocked AnythingLLM's first deploy), so this script only reads it.
set -eu
# shellcheck disable=SC3040  # pipefail where the shell has it; probed first
(set -o pipefail) 2>/dev/null && set -o pipefail || true

# The store URL is a private (VPC) address, so it is not in this file as
# committed: ansible/deploy.yml writes it into the copy it uploads to the box.
# A copy that did not come through the deploy refuses to start.
BAO_ADDR="__BAO_ADDR_FILLED_AT_DEPLOY__"
case "$BAO_ADDR" in
  https://*) ;;
  *) echo "entrypoint-bao: the store URL was not filled in; upload this script with ansible/deploy.yml" >&2; exit 1 ;;
esac
export BAO_ADDR
export BAO_CACERT="${BAO_CACERT:-/.bao-ca.crt}"
_EB_ROLE_ID="{{ bao_role_id }}"
_EB_PATH="{{ bao_secret_path }}"
_EB_SID_FILE="${BAO_SECRET_ID_FILE:-/.bao-secret-id}"

_eb_die() { echo "entrypoint-bao: $*" >&2; exit 1; }

# A key NAME becomes an environment variable name, so it must be a plain
# identifier and must not be one that makes the loader, a shell or the
# interpreter run code. _EB_* is this script's own namespace.
_eb_name_ok() {
  case "$1" in
    ''|[0-9]*|*[!A-Za-z0-9_]*) return 1 ;;
    LD_*|DYLD_*|BASH_ENV|ENV|BASH_FUNC_*|SHELLOPTS|BASHOPTS|PS4|PROMPT_COMMAND|IFS|PATH) return 1 ;;
    NODE_OPTIONS|PYTHON*|_EB_*) return 1 ;;
  esac
  return 0
}

_EB_MODE=""
_EB_KEYS=""
case "${1:-}" in
  --keys) [ $# -ge 2 ] || _eb_die "--keys needs a list"; _EB_MODE=keys; _EB_KEYS="$2"; shift 2 ;;
  --document) _EB_MODE=document; shift ;;
  *) _eb_die "usage: entrypoint-bao.sh --keys \"A B\" -- CMD... | --document -- CMD..." ;;
esac
[ "${1:-}" = "--" ] && shift
[ $# -gt 0 ] || _eb_die "no command to run after the secrets are loaded"

if [ "$_EB_MODE" = keys ]; then
  [ -n "$_EB_KEYS" ] || _eb_die "--keys list is empty"
  for _eb_k in $_EB_KEYS; do
    _eb_name_ok "$_eb_k" || _eb_die "refusing key name '$_eb_k' in the --keys list"
  done
else
  command -v python3 >/dev/null 2>&1 || _eb_die "--document needs python3 in this image; use --keys"
fi

[ -r "$_EB_SID_FILE" ] || _eb_die "$_EB_SID_FILE is missing or not readable by uid $(id -u); run ansible/deploy.yml with BAO_WRAP_TOKEN"
_EB_SID="$(cat "$_EB_SID_FILE")"
[ -n "$_EB_SID" ] || _eb_die "$_EB_SID_FILE is empty"

# Login retries are bounded and end in a long sleep: OpenBao locks an AppRole
# after repeated failed logins and then refuses even the right credential, and
# `restart: unless-stopped` would otherwise retry every few seconds and renew
# the lock (measured on AnythingLLM, 2026-09-01). db and web share this role:
# 2 x 3 attempts stays under the platform mount's tuned threshold of 10.
_EB_ATTEMPTS="${BAO_LOGIN_ATTEMPTS:-3}"
_EB_COOLDOWN="${BAO_LOGIN_COOLDOWN:-300}"
_EB_ERR="$(mktemp 2>/dev/null || echo /tmp/.bao-login-err)"
_EB_TOK=""
_eb_try=1
_eb_delay=2
while [ "$_eb_try" -le "$_EB_ATTEMPTS" ]; do
  # role_id is not secret (it is baked into the render); the secret-id reaches
  # bao on stdin (`secret_id=-`), never on argv.
  if _EB_TOK="$(printf '%s' "$_EB_SID" \
        | bao write -field=token auth/approle/login role_id="$_EB_ROLE_ID" secret_id=- 2>"$_EB_ERR")"; then
    [ "$_eb_try" -gt 1 ] && echo "entrypoint-bao: approle login succeeded on attempt $_eb_try" >&2
    break
  fi
  _EB_TOK=""
  # bao's login error carries no secret: the URL, an HTTP code and a reason.
  cat "$_EB_ERR" >&2
  if [ "$_eb_try" -lt "$_EB_ATTEMPTS" ]; then
    echo "entrypoint-bao: approle login failed (attempt $_eb_try/$_EB_ATTEMPTS); retrying in ${_eb_delay}s" >&2
    sleep "$_eb_delay"
    _eb_delay=$((_eb_delay * 2))
  fi
  _eb_try=$((_eb_try + 1))
done
rm -f "$_EB_ERR"
unset _EB_SID

if [ -z "$_EB_TOK" ]; then
  echo "entrypoint-bao: approle login FAILED after $_EB_ATTEMPTS attempts (role_id $_EB_ROLE_ID)." >&2
  echo "entrypoint-bao:   403 permission denied -> the role may be LOCKED OUT: stop this container," >&2
  echo "entrypoint-bao:     have the store operator clear sys/locked-users, THEN start it." >&2
  echo "entrypoint-bao:   400 invalid role or secret ID -> re-run the deploy with a fresh BAO_WRAP_TOKEN." >&2
  echo "entrypoint-bao: sleeping ${_EB_COOLDOWN}s before exit so a restart policy cannot renew a lockout." >&2
  sleep "$_EB_COOLDOWN"
  exit 1
fi

_eb_revoke() { BAO_TOKEN="$_EB_TOK" bao token revoke -self >/dev/null 2>&1 || true; }

if [ "$_EB_MODE" = keys ]; then
  # One read per key; a missing key refuses the start (no half-configured app).
  # Note: $(...) drops trailing newlines from a value.
  for _eb_k in $_EB_KEYS; do
    if ! _eb_v="$(BAO_TOKEN="$_EB_TOK" bao kv get -mount=weown -field="$_eb_k" "$_EB_PATH" 2>/dev/null)"; then
      _eb_revoke
      _eb_die "key $_eb_k is missing at weown/$_EB_PATH (or the read was refused)"
    fi
    export "$_eb_k=$_eb_v"
  done
  unset _eb_v _eb_k
  _eb_revoke
  unset _EB_TOK _EB_KEYS
  exec "$@"
fi

# --document: python checks every name and emits single-quoted export lines.
# What makes the eval below safe is what the python guarantees: every name is a
# plain identifier outside the denylist, every value is single-quoted with
# embedded quotes escaped and has no NUL, and ONE bad name refuses the whole
# start. A refused name is described by position and length, never printed: a
# malformed "name" is sometimes a secret pasted into the wrong field.
_EB_PY='
import json, re, sys
doc = json.load(sys.stdin)
d = (doc.get("data") or {}).get("data")
if not isinstance(d, dict):
    sys.stderr.write("entrypoint-bao: the kv document is not a flat object of values\n"); sys.exit(3)
q = chr(39)  # a single quote; this program sits inside a single-quoted shell string
ok = re.compile(r"^[A-Za-z_][A-Za-z0-9_]*$")
deny = re.compile(r"^(LD_.*|DYLD_.*|BASH_ENV|ENV|BASH_FUNC_.*|SHELLOPTS|BASHOPTS|PS4|PROMPT_COMMAND|IFS|PATH|NODE_OPTIONS|PYTHON.*|_EB_.*)$")
out = []
for i, (k, v) in enumerate(d.items(), 1):
    if not ok.match(k):
        sys.stderr.write("entrypoint-bao: refusing key #%d (length %d): not a plain identifier\n" % (i, len(k))); sys.exit(3)
    if deny.match(k):
        sys.stderr.write("entrypoint-bao: refusing key %s: it would make the loader, a shell or the interpreter run code\n" % k); sys.exit(3)
    s = v if isinstance(v, str) else json.dumps(v)
    if "\x00" in s:
        sys.stderr.write("entrypoint-bao: refusing the value of %s: it contains a NUL byte\n" % k); sys.exit(3)
    out.append("export %s=%s%s%s" % (k, q, s.replace(q, q + "\\" + q + q), q))
sys.stdout.write("\n".join(out) + "\n")
'
_EB_EXPORTS="$(BAO_TOKEN="$_EB_TOK" bao kv get -mount=weown -format=json "$_EB_PATH" \
               | python3 -c "$_EB_PY")" \
  || { _eb_revoke; _eb_die "kv get failed, or the store document was refused (see above)"; }
_eb_revoke
unset _EB_TOK _EB_PY
# Nothing is unset AFTER the exports: an accepted key must reach the app. The
# text rides in $1 for the eval, and the helper variable is gone first.
set -- "$_EB_EXPORTS" "$@"
unset _EB_EXPORTS
eval "$1"
shift
exec "$@"
