# billing.weown.chat - Caddyfile
# Reverse proxy for the WeOwn billing service (Django/gunicorn)
# No `tls` block: automatic HTTPS via Let's Encrypt is Caddy's default
# (an empty tls block does not even parse — proven on sso.weown.id 2026-07-22).

billing.weown.chat {
    reverse_proxy web:8000

    log {
        output file /var/log/caddy/weown-billing.log
    }
}
