# {{ project_name }} - Docker Compose (ADR-006: In-Container Infisical Injection)
# A Gitea Actions runner (act_runner) and the Docker-in-Docker daemon its jobs run in.
#
# Isolation: every CI job container runs INSIDE the dind sidecar, never on this
# host's Docker. The host socket is mounted nowhere. Pattern from
# perpetuator/mcp infra/ansible/roles/gitea-runner (DinD mode).
#
# ONE JOB PER DAEMON. Nothing here is started with `up` alone: runner-cycle.sh (the
# {{ project_name | replace('-', '_') }}-runner systemd service) runs, for every job,
#   down -v  ->  [register, once]  ->  up dind  ->  load the job image  ->  run runner
# so the containers, volumes, images and daemon state a job leaves behind are
# destroyed before the next job starts. That is why no service has a restart
# policy: systemd restarts the whole cycle.
#
# ONLY `register` sees a credential. It runs once, when data/.runner is missing: it
# logs in to Infisical with the Machine Identity and registers with
# GITEA_RUNNER_REGISTRATION_TOKEN (the runner's OWN project), then exits. `runner`,
# the process that handles untrusted jobs, mounts neither the auth file nor the
# Infisical CLI: it authenticates to Gitea from data/.runner. Delete the token from
# Infisical after registration (README, step 7).

services:
  dind:
    image: {{ dind_image }}
    # PIN the hostname: dind mints its TLS server cert with SANs from its hostname,
    # and the runner (and, with job_docker_access, each job) verifies "dind". With
    # the default random hostname a recreated dind serves a cert without the "dind"
    # SAN and the runner crash-loops on x509 mismatch (perpetuator/mcp, 2026-08-10).
    hostname: dind
    # Required by Docker-in-Docker. Contained to this sidecar; nothing else here
    # is privileged, and the runner reaches it only over TLS.
    privileged: true
    environment:
      DOCKER_TLS_CERTDIR: /certs
    # Volumes, not bind mounts, so `down -v` removes them: every cycle starts with an
    # empty /var/lib/docker and a freshly minted CA and certs.
    volumes:
      - {{ project_name | replace('-', '_') }}_certs_ca:/certs/ca
      - {{ project_name | replace('-', '_') }}_certs_client:/certs/client
      - {{ project_name | replace('-', '_') }}_dind_data:/var/lib/docker
    networks:
      - runnernet
    # Every job runs inside this daemon, so these bound all job containers together.
    # The rest of the droplet stays with the host (sshd, the DO agent, the runner).
    cpus: {{ job_cpus }}
    mem_limit: {{ job_memory }}
    memswap_limit: {{ job_memory }}
    pids_limit: 4096
    healthcheck:
      test: ["CMD", "docker", "info"]
      interval: 5s
      timeout: 5s
      retries: 12

  # One-shot registration: the only service with the Infisical CLI and auth file.
  register:
    image: {{ act_runner_image }}
    # ADR-006: the wrapper logs in to Infisical and runs the registration under
    # `infisical run`, which injects GITEA_RUNNER_REGISTRATION_TOKEN.
    # The token goes to act_runner on STDIN, never argv: every value not given as a
    # flag is read from stdin (act_runner 0.6.1 register, interactive mode, no TTY
    # needed), and printf is a busybox builtin. The env copy is unset first. The
    # wrapper exits before this when data/.runner is non-empty, so a leftover EMPTY
    # file (which would make act_runner ask to overwrite) is removed.
    entrypoint: ["/opt/{{ project_name | replace('-', '_') }}/entrypoint-infisical.sh"]
    command:
      - sh
      - -c
      - >-
        rm -f /data/.runner;
        T="$$GITEA_RUNNER_REGISTRATION_TOKEN"; unset GITEA_RUNNER_REGISTRATION_TOKEN;
        printf '%s\n' "$$T" | act_runner register --config /config.yaml
        --instance "$$GITEA_INSTANCE_URL" --name "$$GITEA_RUNNER_NAME" --labels "$$GITEA_RUNNER_LABELS"
    working_dir: /data
    environment:
      # Infisical CLI TLS: the host CA bundle at a neutral path (never overlay
      # /etc/ssl/certs; see gitea-docker's compose for why).
      SSL_CERT_FILE: /opt/host-ca/ca-certificates.crt
      GITEA_INSTANCE_URL: "{{ gitea_instance_url }}"
      GITEA_RUNNER_NAME: "{{ project_name }}"
      GITEA_RUNNER_LABELS: "ubuntu-latest:docker://{{ job_image.split('@')[0] }}"
    cpus: 0.5
    mem_limit: 256m
    pids_limit: 256
    volumes:
      - /opt/{{ project_name | replace('-', '_') }}/data:/data
      - /opt/{{ project_name | replace('-', '_') }}/config.yaml:/config.yaml:ro
      # ADR-006: Infisical CLI + auth file + wrapper, read-only. The host's own 0600
      # root auth file (registration runs as root); no wider copy exists.
      - /usr/bin/infisical:/usr/bin/infisical:ro
      - /etc/ssl/certs/ca-certificates.crt:/opt/host-ca/ca-certificates.crt:ro
      - /opt/{{ project_name | replace('-', '_') }}/.infisical-auth.env:/.infisical-auth.env:ro
      - /opt/{{ project_name | replace('-', '_') }}/entrypoint-infisical.sh:/opt/{{ project_name | replace('-', '_') }}/entrypoint-infisical.sh:ro
    network_mode: bridge

  runner:
    image: {{ act_runner_image }}
    # Started only by runner-cycle.sh, as `docker compose run`: GITEA_RUNNER_ONCE
    # makes act_runner take one job, run it, and exit (`act_runner daemon --once`).
    # The image's own entrypoint (tini + run.sh): data/.runner exists, so run.sh
    # skips registration. No Infisical CLI, no auth file, no token here.
    environment:
      CONFIG_FILE: /config.yaml
      GITEA_RUNNER_ONCE: "1"
      # The runner drives the dind daemon over TLS, never the host's.
      DOCKER_HOST: tcp://dind:2376
      DOCKER_TLS_VERIFY: "1"
      DOCKER_CERT_PATH: /certs/client
    cpus: 0.5
    mem_limit: 256m
    pids_limit: 256
    volumes:
      - /opt/{{ project_name | replace('-', '_') }}/data:/data
      - /opt/{{ project_name | replace('-', '_') }}/config.yaml:/config.yaml:ro
      - {{ project_name | replace('-', '_') }}_certs_client:/certs/client:ro
    networks:
      - runnernet

volumes:
  {{ project_name | replace('-', '_') }}_certs_ca:
  {{ project_name | replace('-', '_') }}_certs_client:
  {{ project_name | replace('-', '_') }}_dind_data:

networks:
  runnernet:
