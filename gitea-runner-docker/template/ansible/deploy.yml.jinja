---
# {{ project_name }} — Idempotent deployment playbook (Path C app layer)
#
# Cloud-init only bootstraps (Docker, Infisical CLI, .infisical-auth.env and its
# first-boot rotation). This playbook owns everything after that, so a change
# never needs `tofu taint`:
#   - compose.yaml, config.yaml and the Infisical entrypoint wrapper
#   - the pinned images (act_runner, dind, the ubuntu-latest job image)
#   - `docker compose up` (bounced when an uploaded file changed)
#   - a weekly prune of job images inside dind (they accumulate per workflow)
#
# Pre-conditions enforced:
#   - cloud-init finished (.bootstrap-complete exists)
#   - INFISICAL_PROJECT_ID is set (the runner's OWN project)
#
# Usage:
#   INFISICAL_PROJECT_ID=<id> ansible-playbook -i 'root@<droplet-ip>,' \
#     {{ project_name }}/ansible/deploy.yml
#   Or the wrapper: scripts/deploy.sh root@<droplet-ip>

- name: Deploy {{ project_name }} (Gitea Actions runner)
  hosts: all
  gather_facts: false
  become: true
  vars:
    app_dir: /opt/{{ project_name | replace('-', '_') }}
    infisical_project_id: "{{ '{{' }} lookup('env', 'INFISICAL_PROJECT_ID') {{ '}}' }}"
    act_runner_image: {{ act_runner_image }}
    dind_image: {{ dind_image }}
    job_image: {{ job_image }}

  pre_tasks:
    - name: Require INFISICAL_PROJECT_ID env var
      ansible.builtin.assert:
        that:
          - infisical_project_id | length > 0
        fail_msg: >-
          INFISICAL_PROJECT_ID env var is required: the runner's own Infisical
          project (site.conf). Run: INFISICAL_PROJECT_ID=<id> ansible-playbook ...

    - name: Verify droplet has completed cloud-init bootstrap
      ansible.builtin.stat:
        path: "{{ '{{' }} app_dir {{ '}}' }}/.bootstrap-complete"
      register: bootstrap_marker

    - name: Fail clearly if bootstrap is not complete
      ansible.builtin.fail:
        msg: >-
          {{ '{{' }} app_dir {{ '}}' }}/.bootstrap-complete is missing: cloud-init
          has not finished. Wait a few minutes after `tofu apply` and retry; see
          /var/log/cloud-init-output.log on the droplet.
      when: not bootstrap_marker.stat.exists

    - name: Verify Infisical auth file exists (created by cloud-init)
      ansible.builtin.stat:
        path: "{{ '{{' }} app_dir {{ '}}' }}/.infisical-auth.env"
      register: auth_file

    - name: Fail clearly if auth file is missing
      ansible.builtin.fail:
        msg: >-
          {{ '{{' }} app_dir {{ '}}' }}/.infisical-auth.env is missing: the
          Infisical Machine Identity bootstrap failed. Check
          /var/log/cloud-init-output.log and
          /var/log/{{ project_name | replace('-', '_') }}-rotation.log.
      when: not auth_file.stat.exists

  tasks:
    - name: Ensure the runner data directory (holds .runner after registration)
      ansible.builtin.file:
        path: "{{ '{{' }} app_dir {{ '}}' }}/data"
        state: directory
        owner: root
        group: root
        mode: "0700"

    - name: Upload compose.yaml
      ansible.builtin.copy:
        src: ../docker/compose.prod.yaml
        dest: "{{ '{{' }} app_dir {{ '}}' }}/compose.yaml"
        owner: root
        group: root
        mode: "0644"
      notify: Reconcile docker compose stack

    - name: Upload act_runner config.yaml
      ansible.builtin.copy:
        src: ../docker/config.yaml
        dest: "{{ '{{' }} app_dir {{ '}}' }}/config.yaml"
        owner: root
        group: root
        mode: "0644"
      notify: Reconcile docker compose stack

    - name: Upload Infisical entrypoint wrapper (ADR-006)
      ansible.builtin.copy:
        src: ../scripts/entrypoint-infisical.sh
        dest: "{{ '{{' }} app_dir {{ '}}' }}/entrypoint-infisical.sh"
        owner: root
        group: root
        mode: "0755"

    - name: Create container-readable Infisical auth file (ADR-006)
      ansible.builtin.copy:
        src: "{{ '{{' }} app_dir {{ '}}' }}/.infisical-auth.env"
        dest: "{{ '{{' }} app_dir {{ '}}' }}/.infisical-auth.env.container"
        owner: root
        group: root
        mode: "0644"
        remote_src: true
      diff: false   # holds the Machine Identity secret: --check --diff must never print it
      notify: Reconcile docker compose stack

    - name: Pull the pinned images
      community.docker.docker_image_pull:
        name: "{{ '{{' }} item {{ '}}' }}"
      loop:
        - "{{ '{{' }} act_runner_image {{ '}}' }}"
        - "{{ '{{' }} dind_image {{ '}}' }}"
      register: image_pull
      retries: 3
      delay: 5
      until: image_pull is succeeded

    - name: Ensure compose stack is running (idempotent)
      ansible.builtin.shell: |
        set -euo pipefail
        cd {{ '{{' }} app_dir {{ '}}' }}
        docker compose up -d --remove-orphans
      args:
        executable: /bin/bash
      register: compose_up
      changed_when: "'Started' in compose_up.stderr or 'Created' in compose_up.stderr or 'Recreated' in compose_up.stderr"

    - name: Prove the runner registered (data/.runner exists)
      # run.sh registers on first start using GITEA_RUNNER_REGISTRATION_TOKEN
      # from Infisical, then writes /data/.runner. No file = not registered:
      # check `docker compose logs runner` (an expired or reused token is the
      # usual cause; mint a new one in Gitea and store it in Infisical).
      ansible.builtin.stat:
        path: "{{ '{{' }} app_dir {{ '}}' }}/data/.runner"
      register: runner_file
      retries: 24
      delay: 5
      until: runner_file.stat.exists

    - name: Pre-pull the job image inside dind (first job does not wait for it)
      ansible.builtin.command: >-
        docker compose -f {{ '{{' }} app_dir {{ '}}' }}/compose.yaml exec -T dind
        docker pull {{ '{{' }} job_image {{ '}}' }}
      register: job_pull
      changed_when: "'Downloaded newer image' in job_pull.stdout"
      retries: 3
      delay: 10
      until: job_pull.rc == 0

    - name: Weekly prune of job images and stopped containers inside dind
      ansible.builtin.copy:
        content: |
          #!/bin/bash
          # Managed by {{ project_name }}/ansible/deploy.yml: edit there, not here.
          # Removes job images/containers unused for 7 days INSIDE dind; the host's
          # own images (act_runner, dind) are untouched.
          set -euo pipefail
          docker compose -f {{ '{{' }} app_dir {{ '}}' }}/compose.yaml exec -T dind \
            docker system prune -af --filter "until=168h" \
            >> /var/log/{{ project_name | replace('-', '_') }}-prune.log 2>&1
        dest: /etc/cron.weekly/{{ project_name | replace('-', '_') }}-prune
        owner: root
        group: root
        mode: "0750"

    - name: Report success
      ansible.builtin.debug:
        msg: >-
          {{ project_name }} is registered with {{ gitea_instance_url }} and polling for
          jobs labelled ubuntu-latest. Check it shows as Idle in the org's
          Settings -> Actions -> Runners, then delete GITEA_RUNNER_REGISTRATION_TOKEN
          from Infisical (README, step 6).

  handlers:
    - name: Reconcile docker compose stack
      ansible.builtin.shell: |
        set -euo pipefail
        cd {{ '{{' }} app_dir {{ '}}' }}
        docker compose up -d --force-recreate --remove-orphans
      args:
        executable: /bin/bash
      changed_when: false
