# Copy to .env on the host. Never commit .env.
# Bind-mount must be readable by the dropped Hermes uid (not root-only 0600).
# Fill secrets via scripts/inject-secrets.sh (read -rs).
# Infisical path (when wired): weown/platform/hermes/

# --- identity / relay (non-secret) ---
HERMES_BOT_NAME=i.MAIT.bot
DOMAIN=i.mait.bot
BUZZ_RELAY_URL=https://dev.weown.buzz
BUZZ_RELAY_WSS=wss://dev.weown.buzz
BUZZ_TRANSPORT=websocket
BUZZ_CLI_PATH=/usr/local/bin/buzz
GATEWAY_ALLOW_ALL_USERS=true
BUZZ_COMMUNITY_NAME=FELG.WeOwn.Buzz
BUZZ_CHANNEL_NAME=#CCC-MAIT-SQUAD
# Comma-separated Buzz channel UUIDs (empty = all joined). Names above are labels only.
BUZZ_CHANNELS=
BUZZ_HOME_CHANNEL=

# --- Hermes API (Caddy -> imait-bot:8080) ---
API_SERVER_ENABLED=true
API_SERVER_HOST=0.0.0.0
API_SERVER_PORT=8080
API_SERVER_KEY=change-me-generate-on-host

# --- secrets (required for Buzz + inference) ---
BUZZ_PRIVATE_KEY=
OPENROUTER_API_KEY=
