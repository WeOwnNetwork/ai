# git.weown.tools - Caddyfile
# Reverse proxy for Gitea (git over HTTPS; SSH bypasses Caddy on port 2222)

git.weown.tools {
    reverse_proxy gitea:3000 {
        flush_interval -1
    }

    log {
        output file /var/log/caddy/gitea-git.log
    }

    # TLS 1.3 only (weown-fleet#163 group 6). This sets the protocol floor and
    # nothing else: certificates stay automatic (ACME). Never leave this block
    # empty: an empty tls {} does not parse and Caddy exits at startup.
    tls {
        protocols tls1.3
    }
}
