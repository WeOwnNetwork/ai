# {{ domain }} - Caddyfile
# Reverse proxy for Gitea (git over HTTPS; SSH bypasses Caddy on port {{ gitea_ssh_port }})

{{ domain }} {
    reverse_proxy gitea:3000 {
        flush_interval -1
    }

    log {
        output file /var/log/caddy/{{ project_name }}.log
    }

    # No `tls` block: an empty tls{} does not parse ("wrong argument count or
    # unexpected line ending") and Caddy exits at startup -- ACME is automatic.
}
