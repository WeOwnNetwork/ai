# {{ project_name }} - Ansible Requirements
# Install with: ansible-galaxy collection install -r requirements.yml
# Exact pins, bumped on purpose with a PR (weown-fleet#163 group 3): a minimum
# version let every workstation run whatever Galaxy served that day.
# scripts/deploy.sh installs the same community.docker pin.

collections:
  - name: community.docker
    version: "3.13.0"
  # DevSec Hardening Framework — CIS/STIG-aligned os_hardening + ssh_hardening
  # (used by the optional harden.yml play).
  # https://github.com/dev-sec/ansible-collection-hardening
  - name: devsec.hardening
    version: "10.6.0"
