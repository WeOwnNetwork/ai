---
// Guardrail: never display a specific price, bundle, or affiliate percentage
// here — every figure discussed internally is draft and not in writing
// (see the Branding & Marketing guide, §2). This section describes what's
// included and routes to a real conversation instead of a number.
import Button from "./Button.astro";
import Container from "./Container.astro";
import IconCheck from "./icons/IconCheck.astro";

const included = [
  "One dedicated server for your practice",
  "Public website chatbot + private team assistant",
  "Self-serve setup — upload documents before you pay anything",
  "Single sign-on, with self-service password reset",
  "Support for anything that touches your server, widget, or dashboard",
];
---

<section id="pricing" class="bg-surface-1 py-20 md:py-24">
  <Container>
    <div data-reveal class="max-w-2xl">
      <p class="font-mono text-xs uppercase tracking-[0.02em] text-text-faint">Pricing</p>
      <h2 class="mt-3 text-3xl font-bold tracking-[-0.015em] text-text md:text-[36px]">
        Priced per practice, not per seat.
      </h2>
      <p class="mt-5 text-lg text-text-mut">
        Every instance is dedicated to one practice, so pricing is set per
        instance rather than per user. Get started and set up your instance
        first — you won&rsquo;t be asked to pay until it&rsquo;s ready to go
        live.
      </p>
    </div>

    <div data-reveal data-reveal-delay="100" class="mt-12 grid gap-6 rounded-lg border border-white/10 bg-surface-2 p-8 md:grid-cols-[1fr_auto] md:items-center md:gap-12 md:p-10">
      <ul class="space-y-3.5">
        {included.map((item) => (
          <li class="flex items-start gap-3">
            <IconCheck class="mt-0.5 h-5 w-5 shrink-0 text-accent" />
            <span class="text-[15px] text-text">{item}</span>
          </li>
        ))}
      </ul>

      <div class="flex flex-col items-start gap-3 border-t border-white/10 pt-6 md:items-stretch md:border-t-0 md:border-l md:pt-0 md:pl-12">
        <Button href="https://billing.weown.dev" size="lg">Get started</Button>
        <Button href="#faq" variant="secondary" size="lg">Talk to us first</Button>
      </div>
    </div>
  </Container>
</section>
