#!/usr/bin/env bash
# {{ project_name }} — product bootstrap (dashboard + two-workspace model)
#
# Run ONCE per instance after the app is deployed and reachable, from the
# operator workstation. Turns a bare AnythingLLM instance into the WeOwn
# customer product:
#   1. multi-user mode + a WeOwn-held admin — fully via API, zero UI steps
#      (admin password generated, pushed to the secret store, never shown)
#   2. a `manager`-role customer user (referenced by SSO; never handed a password)
#   3. two workspaces: ws-public (embed/website) + ws-private (business docs)
#   4. an embedded chat widget on ws-public, domain-allowlisted
#   5. dashboard secrets pushed to the site's secret store (admin API key, password hash,
#      session secret, embed id) so the dashboard container can boot
#
# Secrets are read with `read -rs` and pushed via the logged-in store CLI
# in-process — never printed, never on disk/history. Idempotent-ish: safe to
# re-run; it skips a workspace/user that already exists.
#
# Prereqs: the site's secret-store CLI (logged in), jq, curl, openssl. The instance reachable at
# https://{{ domain }} (or tunnel http://127.0.0.1:3001 pre-DNS via
#   ssh -N -L 3001:127.0.0.1:3001 root@<ip>  and pass --base http://127.0.0.1:3001).
set -uo pipefail

BASE="https://{{ domain }}"
PROJECT_ID=""
while [[ $# -gt 0 ]]; do case "$1" in
  --base) BASE="$2"; shift 2 ;;
  --project-id) PROJECT_ID="$2"; shift 2 ;;
  *) echo "unknown arg: $1" >&2; exit 1 ;;
esac; done

{% if secret_backend == 'openbao' %}
for b in bao jq curl openssl node; do command -v "$b" >/dev/null || { echo "ERROR: $b not found" >&2; exit 1; }; done
# auth: an already-pinned WeOwn shell (source weown-bao-env.sh + explicit login).
# Fail fast, printing bao's real stderr (2026-08-31: swallowing it misdiagnosed
# a CA-path problem as a token problem).
_ERR="$(bao token lookup 2>&1 >/dev/null)" || { echo "ERROR: no valid bao session for ${BAO_ADDR:-<unset BAO_ADDR>}"; echo "  bao said: ${_ERR:-<no output>}"; exit 1; }

trap 'unset API_KEY CUST_PW SESSION_SECRET PW_HASH ADMIN_PW MGR_PW JWT 2>/dev/null || true' EXIT
# value travels env -> node -> stdin JSON -> kv patch: never argv, never printed.
push(){ K="$1" V="$2" node -e 'const o={};o[process.env.K]=process.env.V;process.stdout.write(JSON.stringify(o))' | bao kv patch -mount=weown "{{ bao_secret_path }}" - >/dev/null 2>&1 && echo "  ✓ set $1" || { echo "  ✗ FAILED $1" >&2; return 1; }; }
{% else %}
for b in infisical jq curl openssl node; do command -v "$b" >/dev/null || { echo "ERROR: $b not found" >&2; exit 1; }; done
[[ -n "$PROJECT_ID" ]] || { read -rp "Site Infisical PROJECT ID: " PROJECT_ID; }
[[ -n "$PROJECT_ID" ]] || { echo "ERROR: project id required" >&2; exit 1; }
infisical whoami >/dev/null 2>&1 || infisical login || { echo "ERROR: infisical login required" >&2; exit 1; }

trap 'unset API_KEY CUST_PW SESSION_SECRET PW_HASH ADMIN_PW MGR_PW JWT 2>/dev/null || true' EXIT
push(){ infisical secrets set "$1=$2" --projectId="$PROJECT_ID" --env=prod --path="${INFISICAL_PATH:-/}" >/dev/null 2>&1 && echo "  ✓ set $1" || { echo "  ✗ FAILED $1" >&2; return 1; }; }
{% endif %}

echo "== 1. Multi-user mode + WeOwn admin (API, zero-UI) =="
# Fresh instances have NO auth: /api/system/enable-multi-user is open until the
# first admin exists, so the whole bootstrap is unattended-capable. Admin creds
# are GENERATED here and pushed to the secret store — WeOwn retrieves them from
# the store when a human needs the UI; no one types or sees them.
MU="$(curl -sS -m 30 "$BASE/api/system/multi-user-mode" | jq -r '.multiUserMode')"
if [[ "$MU" == "true" ]]; then
  echo "  • multi-user already enabled — need existing admin creds to mint the API key"
  read -rp   "  ALLM admin username: " ADMIN_USER
  read -rs -p "  ALLM admin password: " ADMIN_PW; echo
else
  ADMIN_USER="weown-admin"
  ADMIN_PW="$(openssl rand -base64 24 | tr -d '/+=' | cut -c1-24)"
  ADMIN_USER="$ADMIN_USER" ADMIN_PW="$ADMIN_PW" node -e 'const o={username:process.env.ADMIN_USER,password:process.env.ADMIN_PW};process.stdout.write(JSON.stringify(o))' \
    | curl -sS -m 30 -X POST -H "Content-Type: application/json" -d @- "$BASE/api/system/enable-multi-user" \
    | jq -e '.success==true' >/dev/null || { echo "ERROR: enable-multi-user failed" >&2; exit 1; }
  push ALLM_ADMIN_USERNAME "$ADMIN_USER"
  push ALLM_ADMIN_PASSWORD "$ADMIN_PW"
  echo "  ✓ multi-user enabled; admin '$ADMIN_USER' created (password generated → store only)"
fi

# JWT for the frontend-admin API, then a Developer API key — both in-process.
JWT="$(ADMIN_USER="$ADMIN_USER" ADMIN_PW="$ADMIN_PW" node -e 'const o={username:process.env.ADMIN_USER,password:process.env.ADMIN_PW};process.stdout.write(JSON.stringify(o))' \
  | curl -sS -m 30 -X POST -H "Content-Type: application/json" -d @- "$BASE/api/request-token" | jq -r '.token // empty')"
[[ -n "$JWT" ]] || { echo "ERROR: admin login (request-token) failed" >&2; exit 1; }
API_KEY="$(curl -sS -m 30 -X POST -H "Authorization: Bearer $JWT" -H "Content-Type: application/json" -d '{"name":"dashboard"}' "$BASE/api/admin/generate-api-key" | jq -r '.apiKey.secret // empty')"
[[ -n "$API_KEY" ]] || { echo "ERROR: generate-api-key failed" >&2; exit 1; }
api(){ curl -sS -m 60 -H "Authorization: Bearer $API_KEY" -H "Content-Type: application/json" "$@"; }
api "$BASE/api/v1/auth" | jq -e '.authenticated==true' >/dev/null || { echo "ERROR: minted API key did not authenticate" >&2; exit 1; }
echo "  ✓ Developer API key minted and verified"

echo "== 2. Workspaces (ws-public, ws-private) =="
for slug in ws-public ws-private; do
  if api "$BASE/api/v1/workspace/$slug" | jq -e '.workspace' >/dev/null 2>&1; then
    echo "  • $slug exists — skipping"
  else
    name=$([[ "$slug" == ws-public ]] && echo "Public Website Assistant" || echo "Private Business Assistant")
    api -X POST "$BASE/api/v1/workspace/new" -d "$(jq -nc --arg n "$name" '{name:$n}')" \
      | jq -e '.workspace' >/dev/null 2>&1 && echo "  ✓ created $slug ($name)" || echo "  ✗ create $slug failed (check slug naming; ALLM derives slug from name)"
  fi
done

echo "== 3. Embedded chat widget on the public workspace (API) =="
read -rp "  Customer website domain(s) for the embed allowlist (space-separated, blank to allow-all for now): " EMBED_DOMAINS
WS_PUB="$(api "$BASE/api/v1/workspaces" | jq -r '.workspaces[].slug' | grep -m1 '^ws-public\|^public' || echo ws-public)"
EMBED_JSON="$(EMBED_DOMAINS="${EMBED_DOMAINS:-}" WS_PUB="$WS_PUB" node -e 'const d=(process.env.EMBED_DOMAINS||"").trim();const o={workspace_slug:process.env.WS_PUB,chat_mode:"chat",enabled:true};if(d)o.allowlist_domains=JSON.stringify(d.split(/\s+/));process.stdout.write(JSON.stringify(o))')"
EMBED_ID="$(printf '%s' "$EMBED_JSON" | api -X POST "$BASE/api/v1/embed/new" -d @- | jq -r '.embed.uuid // empty')"
if [[ -n "$EMBED_ID" ]]; then push EMBED_ID "$EMBED_ID"; echo "  ✓ embed created ($WS_PUB)"; else echo "  ✗ embed create failed — create it in the UI later and set EMBED_ID in the store"; fi

echo "== 4. Dashboard secrets =="
SESSION_SECRET="$(openssl rand -hex 32)"; push DASHBOARD_SESSION_SECRET "$SESSION_SECRET"
read -rp "  Customer login email: " CUST_EMAIL; [[ -n "${CUST_EMAIL:-}" ]] && push DASHBOARD_CUSTOMER_EMAIL "$CUST_EMAIL"
# manager-role ALLM user (referenced by SSO; never handed a password — generated,
# store-only, resettable by the WeOwn admin).
if [[ -n "${CUST_EMAIL:-}" ]]; then
  MGR_PW="$(openssl rand -base64 24 | tr -d '/+=' | cut -c1-24)"
  CUST_EMAIL="$CUST_EMAIL" MGR_PW="$MGR_PW" node -e 'const o={username:process.env.CUST_EMAIL.toLowerCase().replace(/[^a-z0-9_.@-]/g,""),password:process.env.MGR_PW,role:"manager"};process.stdout.write(JSON.stringify(o))' \
    | api -X POST "$BASE/api/v1/admin/users/new" -d @- | jq -e '.user' >/dev/null 2>&1 \
    && { push ALLM_MANAGER_PASSWORD "$MGR_PW"; echo "  ✓ manager user created (password → store only)"; } \
    || echo "  • manager user create skipped/failed (may already exist)"
  unset MGR_PW
fi
echo "  Set the customer's initial dashboard password (they change it after first login):"
read -rs -p "  password: " CUST_PW; echo
[[ -n "${CUST_PW:-}" ]] || { echo "ERROR: password required" >&2; exit 1; }
# scrypt hash (memory-hard KDF) via node's built-in crypto — never a fast hash,
# and the password reaches node via env (not argv, so not visible in `ps`).
PW_HASH="$(CUST_PW="$CUST_PW" node -e 'const c=require("crypto");const s=c.randomBytes(16);const h=c.scryptSync(process.env.CUST_PW,s,32);process.stdout.write("scrypt$"+s.toString("hex")+"$"+h.toString("hex"))')"
[[ "$PW_HASH" == scrypt\$* ]] || { echo "ERROR: password hash generation failed" >&2; exit 1; }
push DASHBOARD_PASSWORD_HASH "$PW_HASH"
push ALLM_ADMIN_API_KEY "$API_KEY"
push DASHBOARD_VERSION "v0-$(date +%Y%m%d)"

echo
echo "Done. Redeploy so the dashboard container picks up the secrets:"
echo "  ./scripts/deploy.sh root@<ip>"
echo "Then the customer signs in at: $BASE/app/"
echo "No secret value touched disk, history, or this terminal."
