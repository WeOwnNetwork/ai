---
# {{ project_name }} — Idempotent deployment playbook (Path C app layer)
#
# This playbook owns ALL post-bootstrap state on the droplet. Cloud-init only
# handles first-boot bootstrap (Docker, Infisical CLI, .infisical-auth.env,
# bootstrap-secret rotation). Everything else lives here so ongoing changes
# don't require `tofu taint` (which would destroy + recreate the droplet).
#
# What this playbook manages:
#   - compose.yaml (uploaded from docker/compose.prod.yaml)
#   - Caddyfile    (uploaded from docker/Caddyfile)
#   - storage/mcp + storage/plugins (declarative MCP tool pack; no secrets)
#   - dashboard/   (customer dashboard app)
#   - embed-filter/ (public embed reasoning-strip proxy)
#   - backup.sh    (uploaded from scripts/backup.sh)
#   - daily backup cron + logrotate
#   - docker compose up (reconciled — bounced if any uploaded file changed)
#   - DO droplet tagging: feature tags (skinny-backup) + commit tag (commit-<sha>)
#
# Pre-conditions enforced:
#   - The droplet must have completed cloud-init (.bootstrap-complete exists)
#   - INFISICAL_PROJECT_ID must be set in the environment
#   - doctl must be authenticated locally (for tag updates)
#
# Usage:
#   INFISICAL_PROJECT_ID=<id> ansible-playbook -i 'root@<droplet-ip>,' \
#     {{ project_name }}/ansible/deploy.yml
#
#   Or use the wrapper: scripts/deploy.sh root@<droplet-ip>

- name: Deploy {{ project_name }} app layer
  hosts: all
  gather_facts: false
  become: true
  vars:
    app_dir: /opt/{{ project_name | replace('-', '_') }}
    infisical_project_id: "{{ '{{' }} lookup('env', 'INFISICAL_PROJECT_ID') {{ '}}' }}"
    infisical_env: "{{ '{{' }} lookup('env', 'INFISICAL_ENV') | default('prod', True) {{ '}}' }}"
    infisical_path: "{{ '{{' }} lookup('env', 'INFISICAL_PATH') | default('/', True) {{ '}}' }}"
    droplet_name: "{{ project_name }}"
    git_commit_short: "{{ '{{' }} lookup('pipe', 'git rev-parse --short HEAD 2>/dev/null || echo unknown') {{ '}}' }}"
    caddy_image: {{ caddy_image }}

  pre_tasks:
{%- if secret_backend != 'openbao' %}
    - name: Require INFISICAL_PROJECT_ID env var
      ansible.builtin.assert:
        that:
          - infisical_project_id | length > 0
        fail_msg: >-
          INFISICAL_PROJECT_ID env var is required. This is the same value
          as terraform.tfvars infisical_project_id. Run:
          INFISICAL_PROJECT_ID=<id> ansible-playbook ...

    - name: Verify droplet has completed cloud-init bootstrap
      ansible.builtin.stat:
        path: "{{ '{{' }} app_dir {{ '}}' }}/.bootstrap-complete"
      register: bootstrap_marker

    - name: Fail clearly if bootstrap is not complete
      ansible.builtin.fail:
        msg: >-
          {{ '{{' }} app_dir {{ '}}' }}/.bootstrap-complete is missing — droplet
          has not finished cloud-init. Wait a few minutes after `tofu apply`
          and retry. Check /var/log/cloud-init-output.log on the droplet for
          errors.
      when: not bootstrap_marker.stat.exists

    - name: Verify Infisical auth file exists (created by cloud-init)
      ansible.builtin.stat:
        path: "{{ '{{' }} app_dir {{ '}}' }}/.infisical-auth.env"
      register: auth_file

    - name: Fail clearly if auth file is missing
      ansible.builtin.fail:
        msg: >-
          {{ '{{' }} app_dir {{ '}}' }}/.infisical-auth.env is missing —
          Infisical Machine Identity bootstrap failed. Check
          /var/log/cloud-init-output.log and
          /var/log/{{ project_name | replace('-', '_') }}-rotation.log.
      when: not auth_file.stat.exists

    - name: Check for Machine Identity rotation failure (Layer 2 bootstrap)
      ansible.builtin.stat:
        path: "{{ '{{' }} app_dir {{ '}}' }}/.rotation-failed"
      register: rotation_failed_marker

    - name: Check for Machine Identity rotation success
      ansible.builtin.stat:
        path: "{{ '{{' }} app_dir {{ '}}' }}/.rotation-complete"
      register: rotation_complete_marker

    - name: Warn loudly if bootstrap-secret rotation failed
      ansible.builtin.debug:
        msg: >-
          ⚠️  WARNING: Machine Identity bootstrap-secret rotation FAILED on
          this droplet (see {{ '{{' }} app_dir {{ '}}' }}/.rotation-failed and
          /var/log/{{ project_name | replace('-', '_') }}-rotation.log).
          The droplet is still running on its v1 bootstrap secret, which is
          less secure (it briefly existed in Terraform state). This does NOT
          block deployment, but should be fixed via the manual rotation
          runbook in README.md — typically by granting the Machine Identity
          'manage own client secrets' permission in Infisical.
      when: rotation_failed_marker.stat.exists and not rotation_complete_marker.stat.exists
{%- endif %}

  tasks:
{%- if secret_backend == 'openbao' %}
    # ── OpenBao seam setup (SECRET_BACKEND=openbao; openbao repo seam/) ──────
    - name: Verify droplet has completed cloud-init bootstrap (openbao)
      ansible.builtin.stat:
        path: "{{ '{{' }} app_dir {{ '}}' }}/.bootstrap-complete"
      register: bao_bootstrap_marker
      failed_when: not bao_bootstrap_marker.stat.exists

    - name: Install bao CLI (sha256-pinned release tarball)
      ansible.builtin.shell: |
        set -euo pipefail
        command -v bao >/dev/null && {{ '{{' }} 'exit 0' {{ '}}' }}
        cd /tmp
        curl -fsSL -o bao.tar.gz \
          "https://github.com/openbao/openbao/releases/download/v{{ bao_cli_version }}/bao_{{ bao_cli_version }}_Linux_x86_64.tar.gz"
        echo "{{ bao_cli_sha256 }}  bao.tar.gz" | sha256sum -c -
        tar -xzf bao.tar.gz bao && install -m 0755 bao /usr/bin/bao && rm -f bao bao.tar.gz
      args:
        executable: /bin/bash
      changed_when: false

    - name: Place platform-store CA cert
      ansible.builtin.copy:
        src: ../docker/bao-ca.crt
        dest: "{{ '{{' }} app_dir {{ '}}' }}/.bao-ca.crt"
        owner: root
        group: root
        mode: "0644"
      notify: Reconcile docker compose stack

    - name: Upload entrypoint-bao.sh
      ansible.builtin.copy:
        src: ../docker/entrypoint-bao.sh
        dest: "{{ '{{' }} app_dir {{ '}}' }}/entrypoint-bao.sh"
        owner: root
        group: root
        mode: "0755"
      notify: Reconcile docker compose stack

    - name: Unwrap the secret-id on the HOST (first deploy; from BAO_WRAP_TOKEN env)
      # The host needs a WORKING secret-id before `compose up`, because the
      # compose-up task reads ANYTHINGLLM_IMAGE from the store to resolve the
      # image ref. Deferring the unwrap to the container entrypoint deadlocks:
      # the container cannot start without the image, and the image cannot be
      # fetched without the secret-id the entrypoint would have created
      # (measured 2026-08-31: "missing secret_id", .bao-secret-id empty).
      # So unwrap here — the host has bao, the CA, and the wrap token — and the
      # entrypoint's own unwrap stays as an idempotent no-op fallback.
      # cmd: form, not free-form — the free-form splitter chokes on quotes in
      # comments/filters (same class as the compose-up blocks, PR #206).
      ansible.builtin.shell:
        cmd: |
          set -euo pipefail
          SID={{ '{{' }} app_dir {{ '}}' }}/.bao-secret-id
          WRAP={{ '{{' }} app_dir {{ '}}' }}/.bao-wrap.token
          touch "$SID"; chmod 600 "$SID"
          # uid 1000: the app container's USER (anythingllm) reads the secret-id
          # and blanks the wrap token over the bind mounts — root-owned 0600 gave
          # it EACCES, so the entrypoint sent an EMPTY secret_id and bao answered
          # an opaque 400 (measured 2026-09-01). The dashboard runs root and is
          # unaffected either way.
          touch "$WRAP"; chmod 600 "$WRAP"; chown 1000:1000 "$SID" "$WRAP"
          export BAO_ADDR="{{ bao_addr }}" BAO_CACERT={{ '{{' }} app_dir {{ '}}' }}/.bao-ca.crt
          # Values move process-to-process; the secret-id is never printed.
          umask 077
          # VALIDITY, not presence. A secret-id whose accessor has been destroyed
          # or expired is still a non-empty FILE, so an `[ -s "$SID" ]` test says
          # "nothing to unwrap", the deploy no-ops, and the instance stays down
          # holding a credential the store rejects — with a fresh wrap token
          # sitting right there unused. Ask the STORE whether the credential
          # works; that is the contract this task exists to satisfy.
          sid_valid() {
            [ -s "$SID" ] || return 1
            bao write -field=token auth/approle/login \
              role_id="{{ bao_role_id }}" secret_id="$(cat "$SID")" >/dev/null 2>&1
          }
          if sid_valid; then echo "secret-id present and VALID — nothing to unwrap"; exit 0; fi
          [ -s "$SID" ] && echo "secret-id present but REJECTED by the store — replacing it"
          if [ ! -s "$WRAP" ]; then
            [ -n "${BAO_WRAP_TOKEN:-}" ] || { echo "ERROR: need BAO_WRAP_TOKEN env (mint one with scripts/provision-instance.sh in the openbao repo)"; exit 1; }
            printf '%s' "$BAO_WRAP_TOKEN" > "$WRAP"
          fi
          RESP="$(bao unwrap -format=json "$(cat "$WRAP")")" || {
            echo "ERROR: unwrap failed — the wrap token is single-use and expires in 24h."
            echo "       Re-run scripts/provision-instance.sh in the openbao repo to mint a fresh one."
            exit 1; }
          NEW_SID="$(printf '%s' "$RESP" | jq -r '.data.secret_id // empty')"
          ACCESSOR="$(printf '%s' "$RESP" | jq -r '.data.secret_id_accessor // empty')"
          unset RESP
          [ -n "$NEW_SID" ] || { echo "ERROR: unwrap produced an empty secret-id"; exit 1; }
          # The accessor is ALSO a 36-byte UUID, so extracting the wrong field
          # yields a plausible-looking credential that fails only at login — as
          # an opaque 403, an hour downstream, indistinguishable from a lockout
          # (openbao raised exactly this hypothesis during acceptance test 3;
          # it was not the cause that night, but nothing would have caught it).
          # Worse now that we know repeated bad logins LOCK the role: an
          # undetected field slip would lock the instance out of its own store.
          [ "$NEW_SID" != "$ACCESSOR" ] || {
            echo "ERROR: unwrap returned the ACCESSOR, not the secret-id — refusing to write it"; exit 1; }
          printf '%s' "$NEW_SID" > "$SID"
          unset NEW_SID ACCESSOR
          [ -s "$SID" ] || { echo "ERROR: secret-id file is empty after write"; rm -f "$SID"; exit 1; }
          # The credential was REPLACED, so every container still running on the
          # old one must restart to pick it up — and `docker compose up -d` will
          # NOT do that for us. A consumer sitting in the entrypoint's cooldown
          # sleep is "running" as far as compose can tell, so the later compose-up
          # task leaves it alone; the redeploy then writes a perfectly good
          # credential and applies it to nothing (measured 2026-09-01: recovery
          # deploy exit 2 at the health wait, StartedAt unchanged, new secret-id
          # on disk and unused). Restart BOTH consumers: they share this file.
          for c in {{ project_name | replace('-', '_') }}-anythingllm-1 {{ project_name | replace('-', '_') }}-dashboard-1; do
            docker ps -q --filter "name=^${c}$" | grep -q . \
              && docker restart "$c" >/dev/null && echo "restarted consumer $c onto the new secret-id"
          done
          : > "$WRAP"   # single-use: blank it so a leaked copy is worthless
          chown 1000:1000 "$SID" "$WRAP"
          echo "secret-id unwrapped on host (wrap token consumed and blanked)"
      args:
        executable: /bin/bash
      environment:
        BAO_WRAP_TOKEN: "{{ '{{' }} lookup('env', 'BAO_WRAP_TOKEN') {{ '}}' }}"
      changed_when: false

    - name: Note — Spaces backup cron + Infisical OPS-keys sync are SKIPPED on openbao instances
      ansible.builtin.debug:
        msg: >-
          ⚠️ openbao seam instance: the daily Spaces backup cron and
          OPS_AUTHORIZED_KEYS sync are Infisical-coupled and SKIPPED. Shared
          Spaces creds are barred from the store pre-rekey (interim-custody
          ruling); revisit both after the 5-holder rekey.
{%- endif %}
    - name: Upload compose.yaml
      ansible.builtin.copy:
        src: ../docker/compose.prod.yaml
        dest: "{{ '{{' }} app_dir {{ '}}' }}/compose.yaml"
        owner: root
        group: root
        mode: "0644"
      notify: Reconcile docker compose stack

    - name: Upload Caddyfile
      ansible.builtin.copy:
        src: ../docker/Caddyfile
        dest: "{{ '{{' }} app_dir {{ '}}' }}/Caddyfile"
        owner: root
        group: root
        mode: "0644"
      notify: Reconcile docker compose stack

    - name: Upload declarative MCP plugin config
      ansible.builtin.copy:
        src: ../storage/plugins/
        dest: "{{ '{{' }} app_dir {{ '}}' }}/storage/plugins/"
        owner: root
        group: root
        mode: "0644"
        directory_mode: "0755"
      notify: Reconcile docker compose stack

    - name: Upload declarative MCP launcher scripts
      ansible.builtin.copy:
        src: ../storage/mcp/
        dest: "{{ '{{' }} app_dir {{ '}}' }}/storage/mcp/"
        owner: root
        group: root
        mode: "0755"
        directory_mode: "0755"
      notify: Reconcile docker compose stack

    - name: Ensure storage tree is readable by AnythingLLM (UID 1000)
      ansible.builtin.file:
        path: "{{ '{{' }} app_dir {{ '}}' }}/storage"
        state: directory
        owner: 1000
        group: 1000
        recurse: true
      notify: Reconcile docker compose stack

    - name: Upload customer dashboard app (zero-dep Node; bind-mounted ro into the dashboard container)
      ansible.builtin.copy:
        src: ../dashboard/
        dest: "{{ '{{' }} app_dir {{ '}}' }}/dashboard/"
        owner: root
        group: root
        mode: "0644"
        directory_mode: "0755"
      notify: Reconcile docker compose stack

    - name: Upload embed-filter app (zero-dep Node; strips model reasoning off the PUBLIC embed API)
      ansible.builtin.copy:
        src: ../embed-filter/
        dest: "{{ '{{' }} app_dir {{ '}}' }}/embed-filter/"
        owner: root
        group: root
        mode: "0644"
        directory_mode: "0755"
      notify: Reconcile docker compose stack

    - name: Upload shared script library (lib.sh)
      # backup.sh and restore.sh both `source "$SCRIPT_DIR/lib.sh"` on line ~29.
      # Without this upload every backup run dies instantly with
      # "lib.sh: No such file or directory" -- which is why no backup had ever
      # offloaded on any droplet in the fleet (found 2026-07-27 on gitea-git).
      ansible.builtin.copy:
        src: ../scripts/lib.sh
        dest: "{{ '{{' }} app_dir {{ '}}' }}/lib.sh"
        owner: root
        group: root
        mode: "0755"

    - name: Upload backup script
      ansible.builtin.copy:
        src: ../scripts/backup.sh
        dest: "{{ '{{' }} app_dir {{ '}}' }}/backup.sh"
        owner: root
        group: root
        mode: "0750"

    - name: Upload restore script
      # restore.sh remote mode re-execs {{ '{{' }} app_dir {{ '}}' }}/restore.sh on the droplet,
      # so it must exist there for the documented DO-Spaces / skinny-backup restore.
      ansible.builtin.copy:
        src: ../scripts/restore.sh
        dest: "{{ '{{' }} app_dir {{ '}}' }}/restore.sh"
        owner: root
        group: root
        mode: "0750"

{%- if secret_backend != 'openbao' %}
    - name: Upload Infisical entrypoint wrapper (ADR-006)
      # This script authenticates to Infisical and execs the original entrypoint.
      # It is bind-mounted read-only into the container as the container entrypoint.
      # 0755, not 0750: the hardened (Minimus) app image runs NON-ROOT, so the
      # bind-mounted script must be world-readable/executable or the container
      # crash-loops with 'Permission denied' (found live, weown-chat-sales).
      ansible.builtin.copy:
        src: ../scripts/entrypoint-infisical.sh
        dest: "{{ '{{' }} app_dir {{ '}}' }}/entrypoint-infisical.sh"
        owner: root
        group: root
        mode: "0755"

{%- endif %}
    - name: Ensure AWS CLI v2 is installed (backup.sh offload dependency)
      # cloud-init installs this on first boot, but droplets created before
      # that line existed never got it — and `apt install awscli` has NO
      # candidate on Ubuntu 24.04 (noble), so the v2 official installer is
      # the only route. This made backup.sh die at the upload step with
      # `aws: command not found` (found 2026-08-01 on gitea-git during the
      # fleet backup proof run). The deploy play is the re-runnable layer,
      # so the dependency is ensured here, not only at first boot.
      ansible.builtin.shell: |
        set -euo pipefail
        command -v aws >/dev/null 2>&1 && exit 0
        command -v unzip >/dev/null 2>&1 || apt-get install -y -qq unzip
        curl -fsSL https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip -o /tmp/awscliv2.zip
        unzip -q -o /tmp/awscliv2.zip -d /tmp
        /tmp/aws/install --update
        rm -rf /tmp/aws /tmp/awscliv2.zip
        echo INSTALLED
      args:
        executable: /bin/bash
      register: awscli_install
      changed_when: "'INSTALLED' in awscli_install.stdout"

{%- if secret_backend != 'openbao' %}
    - name: Install daily backup cron (wraps backup.sh with Infisical injection)
      ansible.builtin.copy:
        content: |
          #!/bin/bash
          # Daily backup with Infisical runtime secret injection. Managed by
          # {{ project_name }}/ansible/deploy.yml — edit there, not here.
          set -euo pipefail
          # shellcheck disable=SC1091
          source {{ '{{' }} app_dir {{ '}}' }}/.infisical-auth.env
          export INFISICAL_UNIVERSAL_AUTH_CLIENT_ID="$INFISICAL_CLIENT_ID"
          export INFISICAL_UNIVERSAL_AUTH_CLIENT_SECRET="$INFISICAL_CLIENT_SECRET"
          export INFISICAL_TOKEN="$(infisical login --method=universal-auth --plain --silent)"
          infisical run \
            --projectId={{ '{{' }} infisical_project_id {{ '}}' }} \
            --env={{ '{{' }} infisical_env {{ '}}' }} --path={{ '{{' }} infisical_path {{ '}}' }} \
            -- {{ '{{' }} app_dir {{ '}}' }}/backup.sh \
            >> /var/log/{{ project_name | replace('-', '_') }}-backup.log 2>&1
        dest: /etc/cron.daily/{{ project_name | replace('-', '_') }}-backup
        owner: root
        group: root
        mode: "0750"
{%- endif %}

    - name: Ensure logrotate config for backup log
      ansible.builtin.copy:
        content: |
          # Managed by {{ project_name }}/ansible/deploy.yml — do not edit on host.
          /var/log/{{ project_name | replace('-', '_') }}-backup.log {
            weekly
            rotate 12
            compress
            missingok
            notifempty
            create 0640 root root
          }
        dest: /etc/logrotate.d/{{ project_name | replace('-', '_') }}-backup
        owner: root
        group: root
        mode: "0644"

{%- if secret_backend != 'openbao' %}
    # ─── Team SSH access (root authorized_keys, managed from Infisical) ──────
    # Devs SSH in as root to operate this box. Their PUBLIC keys live in the
    # Infisical OPS_AUTHORIZED_KEYS var (one key per line) — the single source
    # of truth. We write them to a SEPARATE file managed exclusively here; the
    # DO-registered break-glass key in .ssh/authorized_keys is never touched
    # (no lock-out risk). Add/remove a key in Infisical + re-run deploy.sh to
    # grant/revoke (revoke = delete the line, e.g. on termination).
    - name: Configure sshd to read the managed team-ops keys file (+ break-glass)
      ansible.builtin.copy:
        content: |
          # Managed by {{ project_name }}/ansible/deploy.yml — do not edit on host.
          # Break-glass key stays in .ssh/authorized_keys; team keys live in
          # .ssh/authorized_keys.weown-ops (from Infisical OPS_AUTHORIZED_KEYS).
          AuthorizedKeysFile .ssh/authorized_keys .ssh/authorized_keys.weown-ops
        dest: /etc/ssh/sshd_config.d/10-weown-ops-keys.conf
        owner: root
        group: root
        mode: "0644"
      notify: Reload sshd

    - name: Sync team ops SSH keys to root (from Infisical OPS_AUTHORIZED_KEYS)
      ansible.builtin.shell: |
        set -euo pipefail
        # shellcheck disable=SC1091
        source {{ '{{' }} app_dir {{ '}}' }}/.infisical-auth.env
        export INFISICAL_UNIVERSAL_AUTH_CLIENT_ID="$INFISICAL_CLIENT_ID"
        export INFISICAL_UNIVERSAL_AUTH_CLIENT_SECRET="$INFISICAL_CLIENT_SECRET"
        export INFISICAL_TOKEN="$(infisical login --method=universal-auth --plain --silent)"
        install -d -m 0700 -o root -g root /root/.ssh
        infisical run --projectId={{ '{{' }} infisical_project_id {{ '}}' }} --env={{ '{{' }} infisical_env {{ '}}' }} --path={{ '{{' }} infisical_path {{ '}}' }} -- bash -c '
          keys="${OPS_AUTHORIZED_KEYS:-}"
          dest=/root/.ssh/authorized_keys.weown-ops
          umask 077; tmp=$(mktemp)
          # Keep only non-blank lines. An unset, empty, or all-whitespace value
          # yields an empty file here; treat that the same as "unset" and leave
          # the destination untouched, so a blank OPS_AUTHORIZED_KEYS can never
          # wipe authorized_keys.weown-ops and revoke all team SSH access.
          printf "%s\n" "$keys" | grep -vE "^[[:space:]]*$" > "$tmp" || true
          if [ ! -s "$tmp" ]; then
            rm -f "$tmp"
            echo "WARN: OPS_AUTHORIZED_KEYS is unset or has no non-blank lines; leaving team keys unchanged."
            exit 0
          fi
          if cmp -s "$tmp" "$dest" 2>/dev/null; then
            rm -f "$tmp"; echo "unchanged"
          else
            install -m 600 -o root -g root "$tmp" "$dest"; rm -f "$tmp"
            echo "synced $(grep -c . "$dest") team key(s)"
          fi
        '
      args:
        executable: /bin/bash
      register: ops_keys_sync
      changed_when: "'synced' in ops_keys_sync.stdout"

{%- endif %}
{%- if secret_backend == 'openbao' %}
    # INTERIM-CUSTODY RULING (openbao review, 2026-08-31): MINIMUS_TOKEN is a
    # SHARED value — barred from the store pre-rekey. openbao instances use the
    # cached-image fallback path below (warn + proceed); revisit at rekey.
    - name: MINIMUS_TOKEN deliberately not fetched on openbao instances (shared value, pre-rekey)
      ansible.builtin.shell: 'echo ""'
      register: minimus_token_result
      changed_when: false
{%- else %}
    - name: Fetch MINIMUS_TOKEN from Infisical (for reg.mini.dev login)
      # caddy:2 lives on reg.mini.dev, which requires authentication even for
      # the "public" caddy image. MINIMUS_TOKEN is optional on re-deploys when
      # the image is already cached locally — an empty fetch must not abort the
      # playbook (see warn/skip tasks below). Fresh droplets still need the
      # secret in Infisical.
      ansible.builtin.shell: |
        set -euo pipefail
        # shellcheck disable=SC1091
        source {{ '{{' }} app_dir {{ '}}' }}/.infisical-auth.env
        export INFISICAL_UNIVERSAL_AUTH_CLIENT_ID="$INFISICAL_CLIENT_ID"
        export INFISICAL_UNIVERSAL_AUTH_CLIENT_SECRET="$INFISICAL_CLIENT_SECRET"
        export INFISICAL_TOKEN="$(infisical login --method=universal-auth --plain --silent)"
        infisical run \
          --projectId={{ '{{' }} infisical_project_id {{ '}}' }} \
          --env={{ '{{' }} infisical_env {{ '}}' }} --path={{ '{{' }} infisical_path {{ '}}' }} \
          -- bash -c 'printf "%s" "${MINIMUS_TOKEN:-}"'
      args:
        executable: /bin/bash
      register: minimus_token
      changed_when: false
      failed_when: false
      no_log: true

{%- endif %}
    - name: Warn when MINIMUS_TOKEN is unset in Infisical
      ansible.builtin.debug:
        msg: >-
          WARNING: MINIMUS_TOKEN is empty or missing in Infisical project
          {{ '{{' }} infisical_project_id {{ '}}' }} (env {{ '{{' }} infisical_env {{ '}}' }}).
          Skipping reg.mini.dev docker login and remote caddy pull — deploy
          will use a locally cached {{ '{{' }} caddy_image {{ '}}' }} if one exists. Add
          MINIMUS_TOKEN to Infisical before provisioning a fresh droplet or
          when bumping the caddy image pin.
      when: minimus_token.stdout | default('') | trim | length == 0

    - name: Log in to reg.mini.dev (Minimus registry)
      # Uses CLI docker login instead of community.docker.docker_login
      # to avoid requiring the Docker SDK for Python on the target host.
      ansible.builtin.shell: |
        printf '%s' '{{ '{{' }} minimus_token.stdout {{ '}}' }}' | docker login reg.mini.dev -u minimus --password-stdin
      args:
        executable: /bin/bash
      changed_when: false
      no_log: true
      when: minimus_token.stdout | default('') | trim | length > 0

    - name: Pull caddy image
      # caddy is a static public ref. The AnythingLLM image is pulled by the
      # compose-up step below — its ref comes from Infisical (ANYTHINGLLM_IMAGE),
      # so it must be pulled under `infisical run`, not here.
      # docker_image_pull is CLI-based (no python3-docker SDK needed on the droplet).
      community.docker.docker_image_pull:
        name: "{{ '{{' }} caddy_image {{ '}}' }}"
      register: image_pull
      retries: 3
      delay: 5
      until: image_pull is succeeded
      when: minimus_token.stdout | default('') | trim | length > 0

    - name: Check for locally cached caddy image (MINIMUS_TOKEN fallback)
      ansible.builtin.command: docker image inspect {{ '{{' }} caddy_image {{ '}}' }}
      register: caddy_image_local
      changed_when: false
      failed_when: false
      when: minimus_token.stdout | default('') | trim | length == 0

    - name: Fail clearly when caddy image is not cached and MINIMUS_TOKEN is missing
      ansible.builtin.fail:
        msg: >-
          MINIMUS_TOKEN is unset in Infisical and {{ '{{' }} caddy_image {{ '}}' }} is not
          cached on this host. Add MINIMUS_TOKEN to Infisical project
          {{ '{{' }} infisical_project_id {{ '}}' }} (env {{ '{{' }} infisical_env {{ '}}' }}) and re-run
          deploy, or manually docker pull {{ '{{' }} caddy_image {{ '}}' }} after logging in
          to reg.mini.dev.
      when:
        - minimus_token.stdout | default('') | trim | length == 0
        - caddy_image_local.rc | default(1) != 0

    - name: Note caddy image using local cache (MINIMUS_TOKEN not set)
      ansible.builtin.debug:
        msg: "Using locally cached {{ '{{' }} caddy_image {{ '}}' }} (MINIMUS_TOKEN not set — remote pull skipped)."
      when:
        - minimus_token.stdout | default('') | trim | length == 0
        - caddy_image_local.rc | default(1) == 0

    - name: Ensure caddy log dir is writable (hardened caddy runs non-root)
      # caddy:2 (Minimus-hardened) runs as a non-root user and writes access
      # logs to the /var/log/caddy host bind mount. Without a writable dir it
      # crash-loops with "permission denied". 0777 is acceptable for a
      # single-tenant log dir; otel-agent also reads these files.
      ansible.builtin.file:
        path: /var/log/caddy
        state: directory
        owner: root
        group: root
        mode: "0777"

    - name: Ensure Caddy Docker volumes are writable (hardened caddy runs as UID 1000)
      # reg.mini.dev/caddy:2 runs as UID 1000. Named volumes created while Caddy
      # ran as root retain root ownership; after --force-recreate, Caddy cannot
      # write Let's Encrypt certs or autosave config -> ERR_SSL_PROTOCOL_ERROR.
      # chown before compose up prevents that drift (same class of issue as
      # /var/log/caddy above). Skip gracefully if volumes do not exist yet
      # (first deploy before compose has created them).
      ansible.builtin.shell: |
        set -euo pipefail
        slug="{{ '{{' }} app_dir | regex_replace('^/opt/', '') {{ '}}' }}"
        for suffix in caddy_data caddy_config; do
          path="/var/lib/docker/volumes/${slug}_${suffix}/_data"
          if [ -d "$path" ]; then
            chown -R 1000:1000 "$path"
          fi
        done
      args:
        executable: /bin/bash
      changed_when: false

    # ─── ADR-006: Container-readable auth file ────────────────────────────
    # The host auth file is 0600 root, but the container may run as non-root.
    # Create a container-readable copy (0644) that the compose bind-mounts
    # read-only. Host-side privacy is preserved by the 0700 app directory.
    # This is the "one fiddly bit" from ADR-006.
{%- if secret_backend != 'openbao' %}
    - name: Create container-readable Infisical auth file (ADR-006)
      ansible.builtin.copy:
        src: "{{ '{{' }} app_dir {{ '}}' }}/.infisical-auth.env"
        dest: "{{ '{{' }} app_dir {{ '}}' }}/.infisical-auth.env.container"
        owner: root
        group: root
        mode: "0644"
        remote_src: true
      notify: Reconcile docker compose stack

{%- endif %}
    - name: "Guard: refuse a storage mount that would strand existing customer data"
      # A mount-type change is invisible at deploy time: the play uploads a new
      # compose, `up -d` recreates the container against an EMPTY directory, the
      # old named volume goes unreferenced, and the app comes up looking healthy
      # with zero workspaces. That is exactly what happened to chat.weown.dev on
      # 2026-07-31. This gate makes it loud instead: if this project's storage
      # volume exists and holds data, the compose about to run MUST mount it.
      # Deliberately shell (not `docker volume inspect --format`) so no Go
      # template braces have to survive jinja rendering.
      ansible.builtin.shell: |
        set -uo pipefail
        VOL="{{ project_name | replace('-', '_') }}_storage"
        COMPOSE="{{ '{{' }} app_dir {{ '}}' }}/compose.yaml"
        docker volume ls -q --filter "name=^${VOL}$" | grep -q . || exit 0
        MP=$(docker volume inspect "$VOL" | grep -o '"Mountpoint": "[^"]*"' | cut -d'"' -f4)
        [ -n "$MP" ] && [ -n "$(ls -A "$MP" 2>/dev/null)" ] || exit 0
        if ! grep -qE '^\s*-\s*anythingllm_storage:/app/server/storage' "$COMPOSE"; then
          echo "REFUSING TO DEPLOY — data-stranding guard tripped."
          echo "  Named volume '$VOL' exists and is NON-EMPTY: $MP"
          echo "  but $COMPOSE does not mount it at /app/server/storage."
          echo "  Deploying would start the app on empty storage and orphan that data."
          echo "  Fix the compose to use the named volume, or migrate the data"
          echo "  deliberately before changing the mount."
          exit 1
        fi
      args:
        executable: /bin/bash
      register: storage_guard
      changed_when: false

    - name: Ensure compose stack is running (idempotent — `up -d` is a no-op if nothing changed)
      # ADR-006: NO host-side `infisical run` wrapper — container fetches secrets
      # via its own entrypoint. A plain `docker compose up -d` starts the stack;
      # each container authenticates to Infisical in-process using the bind-mounted
      # auth file. This enables bounce-to-refresh: `docker restart` re-fetches secrets.
      #
      # Note: ANYTHINGLLM_IMAGE is fetched from Infisical and exported before docker compose up
      # because the compose file uses ${ANYTHINGLLM_IMAGE} for the image reference.
{%- if secret_backend == 'openbao' %}
      ansible.builtin.shell:
        cmd: |
          set -euo pipefail
          export BAO_ADDR="{{ bao_addr }}" BAO_CACERT={{ '{{' }} app_dir {{ '}}' }}/.bao-ca.crt
          TOK="$(bao write -field=token auth/approle/login \
            role_id="{{ bao_role_id }}" secret_id="$(cat {{ '{{' }} app_dir {{ '}}' }}/.bao-secret-id)")"
          # Inject EVERY key at this instance's path, the way `infisical run` does
          # on the infisical path. compose interpolates ${VAR} from the process
          # env at `up` time (ANYTHINGLLM_IMAGE, EMBEDDING_ENGINE, ...), so
          # exporting only the image ref makes compose refuse to start on the
          # next required var (measured 2026-08-31: EMBEDDING_ENGINE missing).
          # -format=json | jq keeps values off argv; the eval never echoes them.
          KVJSON="$(BAO_TOKEN="$TOK" bao kv get -mount=weown -format=json "{{ bao_secret_path }}" \
                    | jq -r '.data.data | to_entries[] | "export \(.key)=\(.value|@sh)"')"
          unset TOK
          eval "$KVJSON"; unset KVJSON
          [[ -n "${ANYTHINGLLM_IMAGE:-}" ]] || { echo "ERROR: ANYTHINGLLM_IMAGE not in weown/{{ bao_secret_path }}"; exit 1; }
          cd {{ '{{' }} app_dir {{ '}}' }}
          docker compose up -d --remove-orphans
  {%- else %}
      ansible.builtin.shell: |
        set -euo pipefail
        source {{ '{{' }} app_dir {{ '}}' }}/.infisical-auth.env
        export INFISICAL_UNIVERSAL_AUTH_CLIENT_ID="$INFISICAL_CLIENT_ID"
        export INFISICAL_UNIVERSAL_AUTH_CLIENT_SECRET="$INFISICAL_CLIENT_SECRET"
        export INFISICAL_TOKEN="$(infisical login --method=universal-auth --plain --silent)"
        export ANYTHINGLLM_IMAGE=$(infisical secrets get ANYTHINGLLM_IMAGE \
          --projectId={{ '{{' }} infisical_project_id {{ '}}' }} \
          --env={{ '{{' }} infisical_env {{ '}}' }} --path={{ '{{' }} infisical_path {{ '}}' }} \
          --plain 2>/dev/null || echo "")
        if [[ -z "$ANYTHINGLLM_IMAGE" ]]; then
          echo "ERROR: ANYTHINGLLM_IMAGE not found in Infisical"
          exit 1
        fi
        cd {{ '{{' }} app_dir {{ '}}' }}
        infisical run --projectId={{ '{{' }} infisical_project_id {{ '}}' }} --env={{ '{{' }} infisical_env {{ '}}' }} --path={{ '{{' }} infisical_path {{ '}}' }} \
          -- docker compose up -d --remove-orphans
  {%- endif %}
      args:
        executable: /bin/bash
      register: compose_up
      changed_when: "'Started' in compose_up.stderr or 'Created' in compose_up.stderr or 'Recreated' in compose_up.stderr"

    - name: Wait for AnythingLLM health
      ansible.builtin.uri:
        url: http://127.0.0.1:3001/api/ping
        status_code: 200
      register: health_probe
      retries: 20
      delay: 5
      until: health_probe.status == 200

    # ─── DO droplet tagging ──────────────────────────────────────────────
    # After a successful deploy, update droplet tags to reflect actual state:
    # - skinny-backup tag (we just configured the cron)
    # - commit-<sha> tag (which git commit produced this deployment)
    # See docs/INFRA_BOOTSTRAP_PATTERN.md "DO tag taxonomy" for the full scheme.
    # Tags are mutated via the shared scripts/tag-droplet.sh helper; ansible
    # runs it locally via delegate_to.

    # Resolve the WeOwn repo root so `scripts/tag-droplet.sh` is reachable even
    # when this play was rendered OUTSIDE the repo. `weown-fleet render-deploy`
    # renders to an ephemeral temp dir, so the old `chdir: playbook_dir |
    # dirname x4` never resolved and `failed_when: false` swallowed it —
    # droplet tagging has therefore NEVER run (0 of 53 droplets carried a
    # commit- tag on 2026-08-22, and #143's blast radius had to be
    # reconstructed by hand). Resolution order: -e weown_repo_root  ->
    # $WEOWN_REPO_ROOT -> git toplevel from playbook_dir.
    - name: Update DO droplet tags (skinny-backup + commit-<sha>)
      ansible.builtin.shell: |
        set -euo pipefail
        ROOT="{{ '{{' }} weown_repo_root | default('', true) {{ '}}' }}"
        [[ -n "$ROOT" ]] || ROOT="${WEOWN_REPO_ROOT:-}"
        [[ -n "$ROOT" ]] || ROOT="$(cd '{{ '{{' }} playbook_dir {{ '}}' }}' && git rev-parse --show-toplevel 2>/dev/null || true)"
        HELPER="$ROOT/scripts/tag-droplet.sh"
        if [[ -z "$ROOT" || ! -x "$HELPER" ]]; then
          echo "TAGGING-SKIPPED: tag-droplet.sh not found (looked under '${ROOT:-<unresolved>}')."
          echo "TAGGING-SKIPPED: this droplet keeps whatever commit- tag it already had."
          echo "TAGGING-SKIPPED: re-run with -e weown_repo_root=/path/to/WeOwnNetwork/ai to fix."
          exit 7
        fi
        "$HELPER" "{{ '{{' }} droplet_name {{ '}}' }}" \
          replace-prefix commit- "commit-{{ '{{' }} git_commit_short {{ '}}' }}" \
          add skinny-backup
      args:
        executable: /bin/bash
      register: _tag_result
      delegate_to: localhost
      become: false
      changed_when: false
      # Tagging is a side-effect: its failure must not red an otherwise good
      # deploy. But it must never be SILENT again — the next task surfaces it.
      failed_when: false

    - name: Surface the droplet-tagging outcome (never silent)
      ansible.builtin.debug:
        msg: "{{ '{{' }} (_tag_result.stdout_lines | default([])) + (_tag_result.stderr_lines | default([])) {{ '}}' }}"
      when: _tag_result.rc | default(0) != 0

    - name: Report success
      ansible.builtin.debug:
        msg: >-
          {{ project_name }} app layer deployed (commit
          {{ '{{' }} git_commit_short {{ '}}' }}).
          URL: https://{{ domain }}/

  handlers:
    - name: Reconcile docker compose stack
      # ADR-006: NO host-side `infisical run` wrapper — container fetches secrets
      # via its own entrypoint. Force-recreate ensures containers pick up any
      # changes to the compose file or bind-mounted auth file.
      #
      # Note: ANYTHINGLLM_IMAGE must be fetched from Infisical before docker compose up
      # because the compose file uses ${ANYTHINGLLM_IMAGE:?} for the image reference.
      # This handler mirrors the main compose-up task.
{%- if secret_backend == 'openbao' %}
      ansible.builtin.shell:
        cmd: |
          set -euo pipefail
          export BAO_ADDR="{{ bao_addr }}" BAO_CACERT={{ '{{' }} app_dir {{ '}}' }}/.bao-ca.crt
          TOK="$(bao write -field=token auth/approle/login \
            role_id="{{ bao_role_id }}" secret_id="$(cat {{ '{{' }} app_dir {{ '}}' }}/.bao-secret-id)")"
          # Inject EVERY key at this instance's path, the way `infisical run` does
          # on the infisical path. compose interpolates ${VAR} from the process
          # env at `up` time (ANYTHINGLLM_IMAGE, EMBEDDING_ENGINE, ...), so
          # exporting only the image ref makes compose refuse to start on the
          # next required var (measured 2026-08-31: EMBEDDING_ENGINE missing).
          # -format=json | jq keeps values off argv; the eval never echoes them.
          KVJSON="$(BAO_TOKEN="$TOK" bao kv get -mount=weown -format=json "{{ bao_secret_path }}" \
                    | jq -r '.data.data | to_entries[] | "export \(.key)=\(.value|@sh)"')"
          unset TOK
          eval "$KVJSON"; unset KVJSON
          [[ -n "${ANYTHINGLLM_IMAGE:-}" ]] || { echo "ERROR: ANYTHINGLLM_IMAGE not in weown/{{ bao_secret_path }}"; exit 1; }
          cd {{ '{{' }} app_dir {{ '}}' }}
          docker compose up -d --force-recreate --remove-orphans
  {%- else %}
      ansible.builtin.shell: |
        set -euo pipefail
        source {{ '{{' }} app_dir {{ '}}' }}/.infisical-auth.env
        export INFISICAL_UNIVERSAL_AUTH_CLIENT_ID="$INFISICAL_CLIENT_ID"
        export INFISICAL_UNIVERSAL_AUTH_CLIENT_SECRET="$INFISICAL_CLIENT_SECRET"
        export INFISICAL_TOKEN="$(infisical login --method=universal-auth --plain --silent)"
        export ANYTHINGLLM_IMAGE=$(infisical secrets get ANYTHINGLLM_IMAGE \
          --projectId={{ '{{' }} infisical_project_id {{ '}}' }} \
          --env={{ '{{' }} infisical_env {{ '}}' }} --path={{ '{{' }} infisical_path {{ '}}' }} \
          --plain 2>/dev/null || echo "")
        if [[ -z "$ANYTHINGLLM_IMAGE" ]]; then
          echo "ERROR: ANYTHINGLLM_IMAGE not found in Infisical"
          exit 1
        fi
        cd {{ '{{' }} app_dir {{ '}}' }}
        infisical run --projectId={{ '{{' }} infisical_project_id {{ '}}' }} --env={{ '{{' }} infisical_env {{ '}}' }} --path={{ '{{' }} infisical_path {{ '}}' }} \
          -- docker compose up -d --force-recreate --remove-orphans
  {%- endif %}
      args:
        executable: /bin/bash
      changed_when: false

    - name: Reload sshd
      # `sshd -t` validates the FULL config (incl. the drop-in) before reload;
      # if it fails we do NOT reload, so the running (working) sshd is untouched.
      ansible.builtin.shell: |
        set -euo pipefail
        sshd -t
        systemctl reload ssh 2>/dev/null || systemctl reload sshd
      args:
        executable: /bin/bash
      changed_when: false
