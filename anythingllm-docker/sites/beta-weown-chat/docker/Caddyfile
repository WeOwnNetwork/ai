
beta-chat.weown.dev {

    # Customer dashboard — the customer-facing surface (auth + doc manager +
    # private chat). Everything under /app is the dashboard container; the
    # dashboard proxies scoped calls to AnythingLLM server-side.
    handle /app* {
        reverse_proxy dashboard:3000
    }

    # PUBLIC embed API — routed through embed-filter, which strips the model's
    # reasoning blocks before they leave the box. MUST stay above the catch-all
    # below: `handle` blocks match in order. The widget hiding those blocks is
    # not a substitute — this endpoint is unauthenticated and curl is a
    # consumer (WO-Disc-961).
    handle /api/embed/* {
        reverse_proxy embed-filter:3002 {

            flush_interval -1
        }
    }

    # AnythingLLM: the (WeOwn-operated) app UI and everything else.
    handle {
        reverse_proxy anythingllm:3001 {

            flush_interval -1
        }
    }
    log {

        # Write to the host-bind-mounted /var/log/caddy/ so otel-agent's
        # filelog/caddy receiver can read this and so logs survive container
        # recreation. See docker/compose.prod.yaml caddy.volumes for the mount.
        output file /var/log/caddy/beta-weown-chat.log
    }
    header {

        X-Content-Type-Options nosniff
        X-Frame-Options SAMEORIGIN
        X-XSS-Protection "1; mode=block"
        Referrer-Policy strict-origin-when-cross-origin
        -Server
    }
}
