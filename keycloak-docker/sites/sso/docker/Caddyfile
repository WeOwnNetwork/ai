# sso.weown.id - Caddyfile
# Reverse proxy for Keycloak SSO

sso.weown.id {
    reverse_proxy keycloak:8080 {
        flush_interval -1
    }

    log {
        output file /var/log/caddy/sso-keycloak.log
    }
}

# 2026-07-22 — two removals, both verified with `caddy validate`:
#
# 1. An empty `tls { }` block used to sit here. It does NOT parse
#    ("wrong argument count or unexpected line ending after '}'"), so Caddy
#    exited on startup and nothing ever listened on 80/443. Automatic HTTPS
#    via Let's Encrypt is Caddy's default — no `tls` block is needed.
#
# 2. The `admin.sso.weown.id` vhost was removed. It was dead weight that D437
#    was meant to replace with an IP allow-list on /admin/*: it proxied to the
#    same Keycloak (so /admin stayed behind the admin login), but the hostname
#    is Cloudflare-PROXIED, so Caddy would have retried a doomed ACME HTTP-01
#    for it indefinitely. Admin remains at https://sso.weown.id/admin
#    (Keycloak 24 path — no /auth prefix).
#
# ⚠️ D437 IS NOT CLOSED: the intended remote_ip allow-list on /admin/* has
#    still not been implemented. /admin is publicly reachable on this vhost.
