# Buzz production environment EXAMPLE — placeholders only.
# Copy to .env on the droplet and replace every CHANGE_ME value.
# NEVER commit a real .env. Prefer generating secrets on the host
# (see scripts/bootstrap-host-env.sh) so values never enter agent context.
#
# Longer-term: migrate secrets into Infisical and inject via
#   infisical run --env=prod -- docker compose up -d
# matching other *-docker services in this repo.

# Image — pin :sha-<7> or a semver tag for production once available.
BUZZ_IMAGE=ghcr.io/block/buzz:main

# Public host (Cloudflare-proxied A record → droplet origin).
BUZZ_DOMAIN=buzz.example.com
RELAY_URL=wss://buzz.example.com
BUZZ_MEDIA_BASE_URL=https://buzz.example.com/media
BUZZ_MEDIA_SERVER_DOMAIN=buzz.example.com
BUZZ_CORS_ORIGINS=https://buzz.example.com

# Closed relay defaults (owner pubkey required).
BUZZ_REQUIRE_AUTH_TOKEN=true
BUZZ_REQUIRE_RELAY_MEMBERSHIP=true
BUZZ_ALLOW_NIP_OA_AUTH=true
BUZZ_AUTO_MIGRATE=true
BUZZ_GIT_CONFORMANCE_PROBE=true
RUST_LOG=buzz_relay=info,buzz_db=info,buzz_auth=info,buzz_pubsub=info,tower_http=info

# Owner identity — 64-char hex Nostr (BIP340) pubkey. Public.
RELAY_OWNER_PUBKEY=CHANGE_ME_OWNER_PUBKEY_HEX

# Stable secrets — generate once, keep stable across restarts, back up securely.
BUZZ_RELAY_PRIVATE_KEY=CHANGE_ME_64_HEX_PRIVATE_KEY
BUZZ_GIT_HOOK_HMAC_SECRET=CHANGE_ME_RANDOM_64_HEX
POSTGRES_DB=buzz
POSTGRES_USER=buzz
POSTGRES_PASSWORD=CHANGE_ME_RANDOM_PASSWORD
REDIS_PASSWORD=CHANGE_ME_RANDOM_PASSWORD
BUZZ_S3_ACCESS_KEY=CHANGE_ME_RANDOM_ACCESS_KEY
BUZZ_S3_SECRET_KEY=CHANGE_ME_RANDOM_SECRET_KEY
BUZZ_S3_BUCKET=buzz-media
BUZZ_S3_ADDRESSING_STYLE=path

# Host ports (Caddy publishes 80/443; relay stays internal when TLS is on).
BUZZ_HTTP_PORT=3000
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443
