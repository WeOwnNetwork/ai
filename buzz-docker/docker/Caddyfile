# Global options — disable unused admin API (WeOwn L2 hardening).
{
	admin off
}

{$BUZZ_DOMAIN} {
	encode zstd gzip

	# NIP-AB mobile pairing (stateless buzz-pair-relay sidecar).
	# handle_path strips /pair so the sidecar sees /.
	handle_path /pair* {
		reverse_proxy pairing-relay:5000
	}

	handle {
		reverse_proxy relay:3000
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		X-XSS-Protection "0"
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}
